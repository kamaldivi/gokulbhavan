# ── macOS ──────────────────────────────────────────
.DS_Store

# ── Frontend (Astro / Node) ─────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.astro/

# Design prototype
design/node_modules/
design/tokens/output.css

# ── PHP API ─────────────────────────────────────────
# Real DB credentials — never commit
api/config.php

# ── Deployment ───────────────────────────────────────
# SFTP credentials — never commit
.deploy.env

# ── Frontend env ────────────────────────────────────
frontend/.env

# ── Media (large binary/audio files — served from server) ───
media/
media_old/

# ── Database dumps — may contain sensitive data ─────
data/*.dump.sql
data/dbs*.sql

# ── Scripts (analysis utilities) ────────────────────
scripts/.env
scripts/__pycache__/
scripts/*.csv          # generated snapshots — large, no need to track

# ── Backend (Python / Flask) ────────────────────────
backend/__pycache__/
backend/**/__pycache__/
backend/*.pyc
backend/.venv/
backend/venv/
backend/.env           # real secrets — never commit
backend/instance/

# Flask-Migrate generated (keep migrations/ folder, ignore SQLite dev db)
*.db
*.sqlite3

# ── Editor ──────────────────────────────────────────
.vscode/settings.json
.idea/
*.swp

# ── Claude Code ─────────────────────────────────────
.claude/
