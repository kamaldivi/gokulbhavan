{
  "name": "gokulbhavan-design",
  "version": "0.1.0",
  "description": "Design prototypes for the Gokul Bhavan suite of websites",
  "private": true,
  "scripts": {
    "dev": "npx concurrently \"npm run tw:watch\" \"npx serve . -p 3000 --no-clipboard\"",
    "tw:build": "npx tailwindcss -i ./tokens/main.css -o ./tokens/output.css",
    "tw:watch": "npx tailwindcss -i ./tokens/main.css -o ./tokens/output.css --watch",
    "build": "npm run tw:build"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.15",
    "concurrently": "^9.1.2",
    "serve": "^14.2.4",
    "tailwindcss": "^3.4.17"
  }
}
