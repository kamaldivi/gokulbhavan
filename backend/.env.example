# Copy this file to .env and fill in values — never commit .env

# Flask
FLASK_ENV=development
FLASK_SECRET_KEY=change-me-to-a-random-string

# MariaDB connection
# Format: mysql+pymysql://user:password@host:port/database
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/gokulbhavan

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:4321

# Admin credentials (simple single-user setup)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
