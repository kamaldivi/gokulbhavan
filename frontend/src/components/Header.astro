---
/**
 * Shared header — Tier 1 (brand strip + icon utility bar) + Tier 2 (nav bar).
 * Supports two-level tree nav: items with children render as dropdowns (desktop)
 * and accordions (mobile).
 */
import { ZOOM_URL, YOUTUBE_URL } from '@lib/site-links';

interface ChildNavItem {
  label: string;
  href: string;
  external?: boolean;
}

interface NavItem {
  label: string;
  href: string;
  children?: ChildNavItem[];
}

interface Props {
  activePath?: string;
  navItems?: NavItem[];
}

const DEFAULT_NAV: NavItem[] = [
  { label: "Home",     href: "/" },
  { label: "Programs", href: "/programs" },
  {
    label: "Bhajans", href: "/bhajans",
    children: [
      { label: "Bhajans",  href: "/bhajans" },
      { label: "Sankirtans",   href: "/sankirtans" },
      { label: "Albums",       href: "/albums" },
    ],
  },
  {
    label: "Slokas", href: "/slokas",
    children: [
      { label: "Slokas",       href: "/slokas" },
      { label: "Slokamritam",  href: "/slokas-new" },
    ],
  },
  { label: "Videos", href: "/videos" },
  {
    label: "Calendar", href: "/vcalendar",
    children: [
      { label: "Vaishnava Calendar",      href: "/vcalendar" },
      { label: "Ekadasi Guidelines", href: "/vcalendar/ekadasi-guidelines" },
      { label: "Ekadasi Recipes",    href: "/vcalendar/ekadasi-recipes" },
    ],
  },
  { label: "Blogs", href: "/blogs" },
  { label: "Books",  href: "https://purebhaktibase.com/?tab=gurudev", external: true },
  {
    label: "About Us", href: "/about",
    children: [
      { label: "About Gokul Bhavan", href: "/about" },
      { label: "Our Bhakti Path",    href: "/krishna-bhakti" },
    ],
  },
  {
    label: "Contact", href: "/contact",
    children: [
      { label: "Contact Us", href: "/contact" },
      { label: "Ask Guruji", href: "/contact#ask-guruji" },
    ],
  },
];

const { activePath = "/", navItems = DEFAULT_NAV } = Astro.props;

/** True if this nav item (or any of its children) matches the current path. */
function isActive(item: NavItem | ChildNavItem, children?: ChildNavItem[]): boolean {
  const href = item.href;
  if (href.startsWith("http")) return false;
  const direct = href === "/" ? activePath === "/" : activePath.startsWith(href);
  if (direct) return true;
  return children?.some(c =>
    !c.href.startsWith("http") &&
    (c.href === "/" ? activePath === "/" : activePath.startsWith(c.href))
  ) ?? false;
}
---

<header class="sticky top-0 z-50 shadow-md">

  <!-- ── Tier 1: Brand strip ─────────────────────────────────── -->
  <div class="bg-brand-parchment border-b border-brand-tan">
    <div class="flex items-center justify-between px-4 sm:px-6 py-3 sm:py-4">

      <!-- Left: Logo + org name -->
      <div class="flex items-center gap-3">
        <a href="/" aria-label="Gokul Bhavan home">
          <img src="/assets/logo.png" alt="Gokul Bhavan Gaudiya Matha seal"
               class="h-12 sm:h-16 w-auto object-contain" />
        </a>
        <div class="leading-snug min-w-0">
          <div class="font-display font-bold text-base sm:text-xl text-brand-navy tracking-tight leading-tight">
            Gokul Bhavan<span class="hidden sm:inline"> Gaudiya Matha</span>
          </div>
          <div class="hidden sm:block font-sans text-xs text-brand-slate mt-1">
            Awakening the souls with pure divine love
          </div>
        </div>
      </div>
      
      <!-- Right: Icon utility strip (desktop only) -->
      <div class="hidden sm:flex items-center gap-0.5">

        <!-- YouTube — Follow -->
        <a href={YOUTUBE_URL} target="_blank" rel="noopener noreferrer"
           title="Follow on YouTube" aria-label="Follow on YouTube"
           class="flex flex-col items-center gap-1 px-2.5 py-1.5 rounded-lg hover:bg-brand-tan/40 transition-colors group">
          <span class="w-9 h-9 rounded-full flex items-center justify-center bg-brand-slate group-hover:bg-brand-navy transition-colors">
            <svg class="w-5 h-5 fill-white" viewBox="0 0 24 24"><path d="M23.495 6.205a3.007 3.007 0 0 0-2.088-2.088c-1.87-.501-9.396-.501-9.396-.501s-7.507-.01-9.396.501A3.007 3.007 0 0 0 .527 6.205a31.247 31.247 0 0 0-.522 5.805 31.247 31.247 0 0 0 .522 5.783 3.007 3.007 0 0 0 2.088 2.088c1.868.502 9.396.502 9.396.502s7.506 0 9.396-.502a3.007 3.007 0 0 0 2.088-2.088 31.247 31.247 0 0 0 .5-5.783 31.247 31.247 0 0 0-.5-5.805zM9.609 15.601V8.408l6.264 3.602z"/></svg>
          </span>
          <span class="text-[10px] font-semibold text-brand-slate group-hover:text-brand-navy transition-colors leading-none">Follow</span>
        </a>

        <!-- Zoom — Connect -->
        <a href={ZOOM_URL} target="_blank" rel="noopener noreferrer"
           title="Join Weekly Online Program" aria-label="Join Weekly Program on Zoom"
           class="flex flex-col items-center gap-1 px-2.5 py-1.5 rounded-lg hover:bg-brand-tan/40 transition-colors group">
          <span class="w-9 h-9 rounded-full flex items-center justify-center bg-brand-slate group-hover:bg-brand-navy transition-colors">
            <svg class="w-5 h-5 fill-white" viewBox="0 0 24 24"><path d="M24 12c0 6.627-5.373 12-12 12S0 18.627 0 12 5.373 0 12 0s12 5.373 12 12zm-6.508-4.5l-3.743 2.688V7.5H6.257C5.563 7.5 5 8.063 5 8.757v6.985h8.249c.694 0 1.257-.563 1.257-1.257V12l3.743 2.7A.375.375 0 0 0 19 14.4V7.8a.375.375 0 0 0-.508-.3z"/></svg>
          </span>
          <span class="text-[10px] font-semibold text-brand-slate group-hover:text-brand-navy transition-colors leading-none">Connect</span>
        </a>

        <!-- Register -->
        <a href="/register"
           title="Register" aria-label="Register"
           class="flex flex-col items-center gap-1 px-2.5 py-1.5 rounded-lg hover:bg-brand-tan/40 transition-colors group">
          <span class="w-9 h-9 rounded-full flex items-center justify-center bg-brand-slate group-hover:bg-brand-navy transition-colors">
            <svg class="w-5 h-5 fill-white" viewBox="0 0 24 24"><path d="M15 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm-9-2V7H4v3H1v2h3v3h2v-3h3v-2H6zm9 4c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
          </span>
          <span class="text-[10px] font-semibold text-brand-slate group-hover:text-brand-navy transition-colors leading-none">Register</span>
        </a>

        <!-- Admin -->
        <a href="/admin"
           title="Admin" aria-label="Admin panel"
           class="flex flex-col items-center gap-1 px-2.5 py-1.5 rounded-lg hover:bg-brand-tan/40 transition-colors group">
          <span class="w-9 h-9 rounded-full flex items-center justify-center bg-brand-slate group-hover:bg-brand-navy transition-colors">
            <svg class="w-5 h-5 fill-white" viewBox="0 0 24 24"><path d="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"/></svg>
          </span>
          <span class="text-[10px] font-semibold text-brand-slate group-hover:text-brand-navy transition-colors leading-none">Admin</span>
        </a>

        <!-- Language toggle — pill, vertically centered -->
        {activePath.startsWith('/tamil') ? (
          <a href="/"
             title="Switch to English" aria-label="Switch to English"
             class="self-center mx-1 flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-brand-slate/10 hover:bg-brand-slate/20 transition-colors border border-brand-slate/15 text-sm font-semibold leading-none whitespace-nowrap">
            <span>🌐</span>
            <span class="text-brand-slate/50">EN</span>
            <span class="text-brand-slate/30">|</span>
            <span class="text-brand-navy font-bold">தமிழ்</span>
          </a>
        ) : (
          <a href="/tamil"
             title="Switch to Tamil" aria-label="Switch to Tamil"
             class="self-center mx-1 flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-brand-slate/10 hover:bg-brand-slate/20 transition-colors border border-brand-slate/15 text-sm font-semibold leading-none whitespace-nowrap">
            <span>🌐</span>
            <span class="text-brand-navy font-bold">EN</span>
            <span class="text-brand-slate/30">|</span>
            <span class="text-brand-slate/50">தமிழ்</span>
          </a>
        )}

      </div>

    </div>
  </div>

  <!-- ── Tier 2: Navigation bar ───────────────────────────────── -->
  <nav class="bg-brand-slate" aria-label="Primary navigation">
    <div class="px-4 sm:px-6 flex items-center justify-between">

      <!-- Desktop nav items -->
      <ul class="hidden md:flex items-stretch h-11 text-sm font-semibold font-sans">
        {navItems.map((item) => (
          item.children ? (
            <!-- Dropdown item -->
            <li class="relative group flex items-stretch">
              <a href={item.href}
                 class={`flex items-center gap-1 px-3 rounded transition-colors ${isActive(item, item.children) ? "bg-brand-navy text-white" : "text-brand-linen hover:bg-brand-navy hover:text-white"}`}>
                {item.label}
                <svg class="w-4 h-4 fill-current opacity-70 mt-px shrink-0" viewBox="0 0 24 24">
                  <path d="M7 10l5 5 5-5z"/>
                </svg>
              </a>
              <!-- Dropdown panel -->
              <ul class="absolute left-0 top-full min-w-[190px] bg-white shadow-xl rounded-b-lg border-t-2 border-brand-lotus
                         invisible opacity-0 group-hover:visible group-hover:opacity-100
                         transition-all duration-150 z-50 py-1">
                {item.children.map((child) => (
                  <li>
                    <a href={child.href}
                       target={child.external ? "_blank" : undefined}
                       rel={child.external ? "noopener noreferrer" : undefined}
                       class={`flex items-center gap-2 px-4 py-2.5 text-sm transition-colors
                               ${isActive(child) ? "bg-brand-parchment text-brand-navy font-semibold" : "text-brand-navy hover:bg-brand-parchment"}`}>
                      <span class="text-brand-lotus text-xs leading-none">›</span>
                      {child.label}
                      {child.external && (
                        <svg class="w-3 h-3 fill-brand-slate/40 ml-auto shrink-0" viewBox="0 0 24 24">
                          <path d="M19 19H5V5h7V3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2v-7h-2v7zM14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3h-7z"/>
                        </svg>
                      )}
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          ) : (
            <!-- Flat item -->
            <li class="flex items-center">
              <a href={item.href}
                 class={`px-3 py-2 rounded transition-colors ${isActive(item) ? "bg-brand-navy text-white" : "text-brand-linen hover:bg-brand-navy hover:text-white"}`}>
                {item.label}
              </a>
            </li>
          )
        ))}
        <!-- My Playlists — functional button, not a page -->
        <li class="flex items-center">
          <button id="hdr-nav-playlist-btn"
                  class="px-3 py-2 rounded text-brand-linen hover:bg-brand-navy hover:text-white transition-colors">
            My Playlists
          </button>
        </li>
      </ul>

      <!-- Mobile: hamburger -->
      <button id="mobile-menu-btn"
              class="md:hidden flex items-center gap-2 h-11 px-2 text-brand-linen hover:text-white text-sm font-semibold"
              aria-label="Toggle menu" aria-expanded="false">
        <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
          <path d="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z"/>
        </svg>
        <span>Menu</span>
      </button>

      <div class="hidden md:block"></div>

    </div>

    <!-- Mobile menu — accordion nav -->
    <div id="mobile-menu" class="hidden md:hidden bg-brand-navy px-4 pb-4">
      <ul class="flex flex-col text-base font-semibold divide-y divide-white/10">

        {navItems.map((item) => (
          item.children ? (
            <!-- Accordion item -->
            <li class="mobile-accordion-item">
              <div class="flex items-center">
                <a href={item.href}
                   class={`flex-1 block py-3 ${isActive(item, item.children) ? "text-white font-bold" : "text-brand-linen hover:text-white transition-colors"}`}>
                  {item.label}
                </a>
                <button class="mobile-accordion-toggle p-3.5 -mr-3.5 text-brand-linen hover:text-white transition-colors"
                        aria-label={`Expand ${item.label}`}>
                  <svg class="w-5 h-5 fill-current transition-transform duration-200" viewBox="0 0 24 24">
                    <path d="M7 10l5 5 5-5z"/>
                  </svg>
                </button>
              </div>
              <ul class="mobile-accordion-panel hidden pb-2 pl-3 space-y-0.5">
                {item.children.map((child) => (
                  <li>
                    <a href={child.href}
                       target={child.external ? "_blank" : undefined}
                       rel={child.external ? "noopener noreferrer" : undefined}
                       class="flex items-center gap-2 py-2 text-sm text-brand-linen/80 hover:text-white transition-colors">
                      <span class="text-brand-tan">›</span>
                      {child.label}
                      {child.external && (
                        <svg class="w-3 h-3 fill-white/30 shrink-0" viewBox="0 0 24 24">
                          <path d="M19 19H5V5h7V3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2v-7h-2v7zM14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3h-7z"/>
                        </svg>
                      )}
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          ) : (
            <!-- Flat item -->
            <li>
              <a href={item.href}
                 class={`block py-3 ${isActive(item) ? "text-white font-bold" : "text-brand-linen hover:text-white transition-colors"}`}>
                {item.label}
              </a>
            </li>
          )
        ))}

        <!-- My Playlists -->
        <li>
          <button id="hdr-mobile-playlist-btn"
                  class="w-full text-left block py-3 text-brand-linen hover:text-white transition-colors">
            My Playlists
          </button>
        </li>

        <!-- Language toggle -->
        <li class="pt-3 flex items-center gap-3 text-sm pb-1">
          <span class="font-bold text-white border-b border-white pb-px">EN</span>
          <span class="text-white/30">·</span>
          <a href="/tamil" class="text-brand-linen hover:text-white transition-colors">தமிழ்</a>
        </li>

      </ul>
    </div>
  </nav>

</header>

<script>
import { totalTrackCount } from '@lib/playlist-store';

(function () {
  // ── Playlist drawer ──────────────────────────────────────────
  function openDrawer() {
    window.dispatchEvent(new CustomEvent('open-playlist-drawer'));
  }
  document.getElementById('hdr-nav-playlist-btn')?.addEventListener('click', openDrawer);
  document.getElementById('hdr-mobile-playlist-btn')?.addEventListener('click', openDrawer);

  // ── Mobile hamburger ─────────────────────────────────────────
  const menuBtn  = document.getElementById('mobile-menu-btn')!;
  const mobileMenu = document.getElementById('mobile-menu')!;
  menuBtn.addEventListener('click', () => {
    const isOpen = !mobileMenu.classList.contains('hidden');
    mobileMenu.classList.toggle('hidden', isOpen);
    menuBtn.setAttribute('aria-expanded', String(!isOpen));
  });

  // ── Mobile accordion toggles ─────────────────────────────────
  document.querySelectorAll('.mobile-accordion-toggle').forEach((btn) => {
    btn.addEventListener('click', () => {
      const li     = btn.closest('.mobile-accordion-item')!;
      const panel  = li.querySelector('.mobile-accordion-panel')!;
      const chevron = btn.querySelector('svg')!;
      const isOpen  = !panel.classList.contains('hidden');
      panel.classList.toggle('hidden', isOpen);
      (chevron as HTMLElement).style.transform = isOpen ? '' : 'rotate(180deg)';
    });
  });
})();
</script>
