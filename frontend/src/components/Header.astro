          <a href="/admin"     class="text-sm font-semibold text-brand-slate hover:text-brand-navy transition-colors">Admin</a>
        </nav>

      </div>

    </div>
  </div>

  <!-- ── Tier 2: Navigation bar ───────────────────────────────── -->
  <nav class="bg-brand-slate" aria-label="Primary navigation">
    <div class="px-4 sm:px-6 flex items-center justify-between">

      <!-- Desktop nav items — hidden on mobile -->
      <ul class="hidden md:flex items-center gap-1 h-11 text-sm font-semibold font-sans">
        {navItems.map((item) => (
          <li>
            <a href={item.href}
               class={isActive(item.href)
                 ? "px-3 py-2 rounded bg-brand-navy text-white"
                 : "px-3 py-2 rounded text-brand-linen hover:bg-brand-navy hover:text-white transition-colors"}>
              {item.label}
            </a>
          </li>
        ))}
        <li>
          <button id="hdr-nav-playlist-btn"
                  class="px-3 py-2 rounded text-brand-linen hover:bg-brand-navy hover:text-white transition-colors">
            My Playlists
          </button>
        </li>
        <li>
          <a href="/ask-guruji.php"
             class="px-3 py-2 rounded text-brand-gold font-bold hover:bg-brand-navy hover:text-white transition-colors">
            Ask Guruji
          </a>
        </li>
      </ul>

      <!-- Mobile: hamburger only -->
      <button id="mobile-menu-btn"
              onclick="document.getElementById('mobile-menu').classList.toggle('hidden')"
              class="md:hidden flex items-center gap-2 h-11 px-2 text-brand-linen hover:text-white text-sm font-semibold"
              aria-label="Toggle menu" aria-expanded="false">
        <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
          <path d="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z"/>
        </svg>
        <span>Menu</span>
      </button>

      <!-- Right: Register CTA (desktop only) -->
      <div class="flex items-center gap-3">
        <a href="/register"
           class="hidden md:inline-flex items-center gap-1.5 bg-brand-lotus hover:bg-pink-700 text-white text-xs font-bold uppercase tracking-wide px-4 py-2 rounded-full transition-colors shadow">
          Register
        </a>
      </div>

    </div>

    <!-- Mobile dropdown — full nav -->
    <div id="mobile-menu" class="hidden md:hidden bg-brand-navy px-4 pb-4">
      <ul class="flex flex-col text-base font-semibold divide-y divide-white/10">
        {navItems.map((item) => (
          <li>
            <a href={item.href}
               class={isActive(item.href)
                 ? "block py-3 text-white font-bold"
                 : "block py-3 text-brand-linen hover:text-white transition-colors"}>
              {item.label}
            </a>
          </li>
        ))}
        <li>
          <button id="hdr-mobile-playlist-btn"
                  class="w-full text-left block py-3 text-brand-linen hover:text-white transition-colors">
            My Playlists
          </button>
        </li>
        <li>
          <a href="/ask-guruji.php"
             class="block py-3 text-brand-gold font-bold hover:text-white transition-colors">
            Ask Guruji
          </a>
        </li>
        <li class="pt-3 pb-1">
          <a href="/register"
             class="w-full inline-flex items-center justify-center bg-brand-lotus hover:bg-pink-700 text-white text-sm font-bold uppercase tracking-wide px-4 py-3 rounded-full transition-colors">
            Register
          </a>
        </li>
        <li class="pt-3 flex gap-5 flex-wrap">
          <a href="https://purebhaktibase.com/?tab=gurudev" target="_blank" rel="noopener noreferrer" class="text-brand-linen hover:text-white text-sm">Books</a>
          <a href="https://gokulbhajans.com/"               target="_blank" rel="noopener noreferrer" class="text-brand-linen hover:text-white text-sm">Blogs</a>
          <a href="https://www.facebook.com/gokulbhajan"    target="_blank" rel="noopener noreferrer" class="text-brand-linen hover:text-white text-sm">Facebook</a>
          <a href="https://www.youtube.com/@bkdasa"         target="_blank" rel="noopener noreferrer" class="text-brand-linen hover:text-white text-sm">YouTube</a>
          <a href="https://us02web.zoom.us/j/2294369627?pwd=VHJPQ1dBTC9wVnV2dUd5UDVMYTJwQT09" target="_blank" rel="noopener noreferrer" class="text-brand-linen hover:text-white text-sm">Zoom</a>
          <a href="/contact" class="text-brand-linen hover:text-white text-sm">Contact</a>
        </li>
      </ul>
    </div>
  </nav>

</header>

<script>
import { totalTrackCount } from '@lib/playlist-store';

(function () {
  function openDrawer() {
    window.dispatchEvent(new CustomEvent('open-playlist-drawer'));
  }

  document.getElementById('hdr-nav-playlist-btn')?.addEventListener('click', openDrawer);
  document.getElementById('hdr-mobile-playlist-btn')?.addEventListener('click', openDrawer);
})();
</script>
