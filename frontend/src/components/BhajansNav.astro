---
interface Props { activePath: string; }
const { activePath } = Astro.props;

const tabs = [
  { label: "Bhajans",     href: "/bhajans" },
  { label: "Saṅkīrtans", href: "/sankirtans" },
  { label: "Albums",      href: "/albums" },
];

function isActive(href: string): boolean {
  return activePath === href || activePath.startsWith(href + '/');
}
---

<div class="border-b border-brand-tan bg-white">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <nav class="flex gap-1 -mb-px" aria-label="Bhajans sections">
      {tabs.map(tab => (
        <a
          href={tab.href}
          class={isActive(tab.href)
            ? "inline-flex items-center px-4 py-3 text-sm font-semibold border-b-2 border-brand-lotus text-brand-lotus whitespace-nowrap"
            : "inline-flex items-center px-4 py-3 text-sm font-semibold border-b-2 border-transparent text-brand-slate hover:text-brand-navy hover:border-brand-tan transition-colors whitespace-nowrap"}
        >
          {tab.label}
        </a>
      ))}
    </nav>
  </div>
</div>
