---
/**
 * EventWidget — shows upcoming events for a given placement as clickable cards.
 * Clicking a card opens a detail modal with blurred background.
 * URL updates to ?event={slug} for shareability; handles direct links on load.
 *
 * Props:
 *   placement  — 'home' | 'tamil' | 'programs'  (matches post_category.placement)
 *   title      — section heading (default "Upcoming Events")
 */

interface Props {
  placement: 'home' | 'tamil' | 'programs';
  title?: string;
}

const { placement, title = 'Upcoming Events' } = Astro.props;

const listId     = `ev-list-${placement}`;
const modalId    = `ev-modal-${placement}`;
const backdropId = `ev-backdrop-${placement}`;
const closeId    = `ev-close-${placement}`;
const contentId  = `ev-content-${placement}`;
---

<section class="max-w-6xl mx-auto px-4 sm:px-6 py-10 border-t border-brand-tan" aria-label="Upcoming Events">
  <div class="flex items-center justify-between mb-6">
    <div>
      <p class="text-[11px] font-bold uppercase tracking-widest text-brand-lotus mb-1">Events</p>
      <h2 class="font-display font-bold text-2xl text-brand-navy">{title}</h2>
    </div>
  </div>
  <div id={listId} class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
    <div class="col-span-full text-center py-8 text-brand-slate/40 text-sm">Loading events…</div>
  </div>
</section>

<!-- ── Event detail modal ──────────────────────────────────────── -->
<div id={modalId} class="hidden fixed inset-0 z-50 overflow-y-auto" role="dialog" aria-modal="true" aria-label="Event details">

  <!-- Backdrop -->
  <div id={backdropId} class="fixed inset-0 bg-black/60 backdrop-blur-sm"></div>

  <!-- Panel wrapper (scrollable) -->
  <div class="relative flex items-start justify-center min-h-full p-4 py-10">
    <div class="relative bg-white rounded-2xl shadow-2xl w-full max-w-2xl overflow-hidden">

      <!-- Close button (top-right, overlays cover image) -->
      <button id={closeId} aria-label="Close"
              class="absolute top-3 right-3 z-10 w-8 h-8 flex items-center justify-center
                     rounded-full bg-black/40 hover:bg-black/60 text-white transition-colors">
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
          <path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
        </svg>
      </button>

      <!-- Content injected by JS -->
      <div id={contentId}></div>

    </div>
  </div>
</div>

<style>
  /* Prose styles for event body HTML rendered inside the modal */
  .ev-prose h2  { font-size: 1.2rem; font-weight: 700; margin: 1.25rem 0 0.5rem; color: #1a2a5e; }
  .ev-prose h3  { font-size: 1rem;   font-weight: 700; margin: 1rem 0 0.375rem; color: #1a2a5e; }
  .ev-prose p   { margin: 0 0 0.75rem; color: #475569; line-height: 1.7; font-size: 0.9rem; }
  .ev-prose ul,
  .ev-prose ol  { padding-left: 1.4rem; margin: 0 0 0.75rem; color: #475569; font-size: 0.9rem; }
  .ev-prose li  { margin-bottom: 0.25rem; line-height: 1.6; }
  .ev-prose ul  { list-style-type: disc; }
  .ev-prose ol  { list-style-type: decimal; }
  .ev-prose blockquote {
    border-left: 3px solid #c084a0;
    margin: 0.75rem 0;
    padding: 0.5rem 1rem;
    background: #faf8f4;
    color: #334155;
    font-style: italic;
    font-size: 0.9rem;
  }
  .ev-prose strong { font-weight: 600; }
  .ev-prose em     { font-style: italic; }
  .ev-prose a      { color: #c084a0; text-decoration: underline; }
  .ev-prose p + ul,
  .ev-prose p + ol { margin-top: -0.25rem; }
</style>

<script define:vars={{ placement }}>
(function () {
  const apiBase   = '';
  const listEl    = document.getElementById(`ev-list-${placement}`);
  const modalEl   = document.getElementById(`ev-modal-${placement}`);
  const backdropEl = document.getElementById(`ev-backdrop-${placement}`);
  const closeBtn  = document.getElementById(`ev-close-${placement}`);
  const contentEl = document.getElementById(`ev-content-${placement}`);

  // ── Helpers ───────────────────────────────────────────────────
  function esc(s) {
    return String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  function ytId(ref) {
    if (!ref) return null;
    const m = ref.match(/(?:youtube\.com\/(?:watch\?v=|embed\/)|youtu\.be\/)([a-zA-Z0-9_-]{11})/);
    return m ? m[1] : (ref.trim().length === 11 && /^[a-zA-Z0-9_-]+$/.test(ref.trim()) ? ref.trim() : null);
  }

  function fmtDate(dateStr) {
    if (!dateStr) return null;
    // dateStr may be "2024-12-25" or "2024-12-25 00:00:00"
    const d = new Date(dateStr.slice(0, 10) + 'T00:00:00');
    return d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
  }

  // ── URL management ────────────────────────────────────────────
  function pushEventUrl(slug) {
    const p = new URLSearchParams(window.location.search);
    p.set('event', slug);
    history.pushState({ event: slug }, '', `${window.location.pathname}?${p}`);
  }

  function clearEventUrl() {
    const p = new URLSearchParams(window.location.search);
    p.delete('event');
    const qs = p.toString();
    history.replaceState(null, '', window.location.pathname + (qs ? '?' + qs : ''));
  }

  // ── ESC key ───────────────────────────────────────────────────
  function onEsc(e) { if (e.key === 'Escape') closeModal(); }

  // ── Open / close modal ────────────────────────────────────────
  function openModalShell(slug) {
    contentEl.innerHTML = `<div class="p-12 text-center text-brand-slate/40 text-sm">Loading…</div>`;
    modalEl.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
    pushEventUrl(slug);
    document.addEventListener('keydown', onEsc);
  }

  function closeModal() {
    // Stop any playing iframes
    contentEl.querySelectorAll('iframe').forEach(f => { const s = f.src; f.src = ''; f.src = s; });
    modalEl.classList.add('hidden');
    document.body.style.overflow = '';
    clearEventUrl();
    document.removeEventListener('keydown', onEsc);
  }

  closeBtn.addEventListener('click', closeModal);
  backdropEl.addEventListener('click', closeModal);

  // ── Render modal content ──────────────────────────────────────
  function renderModal(post) {
    let html = '';

    if (post.cover_image_path) {
      html += `<div class="w-full bg-brand-navy">
        <img src="/${esc(post.cover_image_path)}" alt="${esc(post.title)}"
             class="w-full object-contain" />
      </div>`;
    }

    const d1 = fmtDate(post.event_date);
    const d2 = fmtDate(post.event_end_date);
    const dateRange = d1 ? (d2 && d2 !== d1 ? `${d1} – ${d2}` : d1) : null;

    if (dateRange || post.event_location) {
      html += `<div class="bg-brand-navy px-6 py-3 flex flex-wrap gap-x-6 gap-y-1.5 text-white text-sm">`;
      if (dateRange) {
        html += `<span class="flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 fill-current opacity-70 shrink-0" viewBox="0 0 24 24">
            <path d="M19 3h-1V1h-2v2H8V1H6v2H5c-1.11 0-1.99.9-1.99 2L3 19c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11zM7 10h5v5H7z"/>
          </svg>${esc(dateRange)}</span>`;
      }
      if (post.event_location) {
        html += `<span class="flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 fill-current opacity-70 shrink-0" viewBox="0 0 24 24">
            <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
          </svg>${esc(post.event_location)}</span>`;
      }
      html += `</div>`;
    }

    html += `<div class="px-6 pt-5 pb-6">`;
    html += `<h2 class="font-display font-bold text-2xl text-brand-navy mb-3 leading-snug">${esc(post.title)}</h2>`;

    if (post.extract) {
      html += `<p class="text-brand-slate text-base leading-relaxed mb-4">${esc(post.extract)}</p>`;
    }

    if (post.body && post.body.trim()) {
      html += `<div class="ev-prose mb-4">${post.body}</div>`;
    }

    if (post.media && post.media.length) {
      const ytItems   = post.media.filter(m => m.media_type === 'youtube');
      const imgItems  = post.media.filter(m => m.media_type === 'image');
      const miscItems = post.media.filter(m => ['harikatha','link','playlist'].includes(m.media_type));

      if (ytItems.length) {
        html += `<div class="space-y-3 mb-4">`;
        ytItems.forEach(m => {
          const id = ytId(m.media_ref);
          if (!id) return;
          html += `<div class="rounded-xl overflow-hidden bg-black" style="aspect-ratio:16/9">
            <iframe src="https://www.youtube.com/embed/${id}"
                    class="w-full h-full"
                    allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    allowfullscreen loading="lazy"></iframe>
          </div>`;
          if (m.caption) html += `<p class="text-xs text-brand-slate/60">${esc(m.caption)}</p>`;
        });
        html += `</div>`;
      }

      if (imgItems.length) {
        html += `<div class="grid grid-cols-2 gap-3 mb-4">`;
        imgItems.forEach(m => {
          html += `<img src="/${esc(m.media_ref)}" alt="${esc(m.caption ?? '')}"
                        class="rounded-lg w-full object-cover" loading="lazy" />`;
        });
        html += `</div>`;
      }

      if (miscItems.length) {
        html += `<div class="flex flex-wrap gap-2 mt-1 mb-2">`;
        miscItems.forEach(m => {
          const label = m.caption || (m.media_type === 'playlist' ? 'View Playlist' : m.media_type === 'harikatha' ? 'Listen' : 'Learn More');
          if (m.media_type === 'playlist') {
            html += `<span class="inline-flex items-center gap-1.5 bg-brand-parchment border border-brand-tan text-brand-navy text-xs font-semibold px-3 py-1.5 rounded-full">
              <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M15 6H3v2h12V6zm0 4H3v2h12v-2zM3 16h8v-2H3v2zM17 6v8.18c-.31-.11-.65-.18-1-.18-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3V8h3V6h-5z"/></svg>
              ${esc(label)}
            </span>`;
          } else {
            html += `<a href="${esc(m.media_ref)}" target="_blank" rel="noopener noreferrer"
                       class="inline-flex items-center gap-1.5 bg-brand-navy text-white text-xs font-semibold px-3 py-1.5 rounded-full hover:bg-brand-slate transition-colors">
              ${esc(label)}
              <svg class="w-3 h-3 fill-current" viewBox="0 0 24 24"><path d="M19 19H5V5h7V3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7h-2v7zM14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3h-7z"/></svg>
            </a>`;
          }
        });
        html += `</div>`;
      }
    }

    html += `</div>`;
    return html;
  }

  // ── Render card ───────────────────────────────────────────────
  function renderCard(ev) {
    const dateStr = fmtDate(ev.event_date);
    let html = `<button type="button"
      class="ev-card group text-left rounded-xl border border-brand-tan bg-white hover:shadow-md transition-all overflow-hidden flex flex-col w-full cursor-pointer"
      data-slug="${esc(ev.slug)}">`;

    if (ev.cover_image_path) {
      html += `<div class="w-full h-44 overflow-hidden bg-brand-navy shrink-0">
        <img src="/${esc(ev.cover_image_path)}" alt="${esc(ev.title)}"
             class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy" />
      </div>`;
    }

    html += `<div class="flex-1 flex flex-col p-4">`;
    if (dateStr) {
      html += `<p class="text-[11px] font-bold uppercase tracking-wider text-brand-lotus mb-1.5">${esc(dateStr)}</p>`;
    }
    html += `<h3 class="font-display font-bold text-base text-brand-navy leading-snug mb-2 group-hover:text-brand-lotus transition-colors">${esc(ev.title)}</h3>`;
    if (ev.extract) {
      html += `<p class="text-sm text-brand-slate leading-relaxed line-clamp-3 flex-1">${esc(ev.extract)}</p>`;
    }
    if (ev.event_location) {
      html += `<p class="text-xs text-brand-slate/60 mt-2 flex items-center gap-1">
        <svg class="w-3 h-3 fill-current shrink-0" viewBox="0 0 24 24">
          <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
        </svg>${esc(ev.event_location)}</p>`;
    }
    html += `</div></button>`;
    return html;
  }

  // ── Fetch and open event ──────────────────────────────────────
  async function openEvent(slug) {
    openModalShell(slug);
    try {
      const res = await fetch(`${apiBase}/api/posts.php?slug=${encodeURIComponent(slug)}`);
      if (!res.ok) throw new Error();
      const post = await res.json();
      contentEl.innerHTML = renderModal(post);
    } catch {
      contentEl.innerHTML = `<div class="p-10 text-center text-red-600 text-sm">Could not load event. Please try again.</div>`;
    }
  }

  // ── Load event listing ────────────────────────────────────────
  async function loadEvents() {
    try {
      const res = await fetch(`${apiBase}/api/posts.php?type=event&cat_placement=${encodeURIComponent(placement)}&per_page=5`);
      if (!res.ok) throw new Error();
      const data = await res.json();
      const events = data.posts ?? [];

      if (!events.length) {
        listEl.innerHTML = `<p class="col-span-full text-center text-brand-slate/40 text-sm py-6">No upcoming events.</p>`;
        return;
      }

      listEl.innerHTML = events.map(renderCard).join('');
      listEl.querySelectorAll('.ev-card').forEach(btn => {
        btn.addEventListener('click', () => openEvent(btn.dataset.slug));
      });
    } catch {
      listEl.innerHTML = '';
    }
  }

  // ── Handle direct ?event= URL on load ────────────────────────
  const initSlug = new URLSearchParams(window.location.search).get('event');
  if (initSlug) openEvent(initSlug);

  // Handle browser back/forward
  window.addEventListener('popstate', () => {
    const slug = new URLSearchParams(window.location.search).get('event');
    if (slug) {
      openEvent(slug);
    } else if (!modalEl.classList.contains('hidden')) {
      modalEl.classList.add('hidden');
      document.body.style.overflow = '';
      document.removeEventListener('keydown', onEsc);
    }
  });

  loadEvents();
})();
</script>
