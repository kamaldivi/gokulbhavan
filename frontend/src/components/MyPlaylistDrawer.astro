---
/**
 * MyPlaylistDrawer
 * ────────────────
 * Slide-in drawer (right side) showing all user playlists.
 *
 * Include once in Base.astro (after PlaylistPicker).
 * Opens on:  window.dispatchEvent(new CustomEvent('open-playlist-drawer'))
 * Closes on: ESC, backdrop click, or close button.
 *
 * Features:
 *   - List all playlists with track count
 *   - Expand each playlist to see tracks, reorder (↑/↓), remove (✕)
 *   - Play playlist button → sends queue to AudioPlayer
 *   - Create new playlist inline
 *   - Delete playlist with confirmation
 *   - Reactive: listens on 'playlist-changed' to stay in sync
 */
---

<!-- ── Backdrop ────────────────────────────────────────────── -->
<div id="mpd-backdrop"
     class="fixed inset-0 z-[400] bg-black/50 hidden"
     aria-hidden="true"></div>

<!-- ── Drawer ─────────────────────────────────────────────── -->
<div id="mpd-drawer"
     role="dialog"
     aria-modal="true"
     aria-labelledby="mpd-heading"
     class="fixed top-0 right-0 bottom-0 z-[401]
            w-full max-w-sm bg-white shadow-2xl
            flex flex-col
            translate-x-full transition-transform duration-300
            hidden">

  <!-- Header -->
  <div class="flex items-center justify-between px-5 py-4 border-b border-brand-tan shrink-0">
    <div>
      <h2 id="mpd-heading" class="font-display font-bold text-brand-navy text-lg">
        My Playlists
      </h2>
      <p id="mpd-summary" class="text-xs text-brand-slate/60 mt-0.5"></p>
    </div>
    <button id="mpd-close"
            class="w-8 h-8 flex items-center justify-center rounded-full
                   text-brand-slate hover:text-brand-navy hover:bg-brand-parchment transition-colors"
            aria-label="Close">
      <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
        <path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
      </svg>
    </button>
  </div>

  <!-- Playlist list -->
  <div id="mpd-list" class="flex-1 overflow-y-auto px-3 py-3 space-y-2"></div>

  <!-- Empty state -->
  <div id="mpd-empty"
       class="hidden flex-1 flex flex-col items-center justify-center px-8 py-12 text-center">
    <svg class="w-14 h-14 fill-brand-tan mb-4" viewBox="0 0 24 24">
      <path d="M17 3H7c-1.1 0-1.99.9-1.99 2L5 21l7-3 7 3V5c0-1.1-.9-2-2-2zm0 15l-5-2.18L7 18V5h10v13z"/>
    </svg>
    <p class="font-semibold text-brand-navy mb-1">No playlists yet</p>
    <p class="text-sm text-brand-slate/60">Save tracks using the bookmark icon on any page.</p>
  </div>

  <!-- Footer: create new playlist -->
  <div class="px-4 pb-5 pt-3 border-t border-brand-tan shrink-0">
    <div class="flex gap-2">
      <input id="mpd-new-name"
             type="text"
             placeholder="New playlist name…"
             maxlength="60"
             class="flex-1 px-3 py-2 text-sm rounded-lg border border-brand-tan
                    focus:outline-none focus:ring-2 focus:ring-brand-lotus
                    placeholder:text-brand-slate/40" />
      <button id="mpd-create-btn"
              class="shrink-0 bg-brand-navy hover:bg-brand-slate text-white
                     text-xs font-bold px-4 py-2 rounded-lg transition-colors">
        Create
      </button>
    </div>
  </div>

</div>


<script>
import {
  getPlaylists, createPlaylist, deletePlaylist, renamePlaylist,
  removeTrack, moveTrack,
  type Playlist, type PlaylistTrack,
} from '@lib/playlist-store';

// ── DOM ────────────────────────────────────────────────────────
const backdrop  = document.getElementById('mpd-backdrop')!;
const drawer    = document.getElementById('mpd-drawer')!;
const closeBtn  = document.getElementById('mpd-close')!;
const list      = document.getElementById('mpd-list')!;
const emptyEl   = document.getElementById('mpd-empty')!;
const summary   = document.getElementById('mpd-summary')!;
const newName   = document.getElementById('mpd-new-name') as HTMLInputElement;
const createBtn = document.getElementById('mpd-create-btn')!;

// track which playlist is expanded
let expandedId: string | null = null;

// ── Open / close ───────────────────────────────────────────────
function open() {
  render();
  drawer.classList.remove('hidden');
  backdrop.classList.remove('hidden');
  requestAnimationFrame(() => drawer.classList.remove('translate-x-full'));
  newName.focus();
}

function close() {
  drawer.classList.add('translate-x-full');
  backdrop.classList.add('hidden');
  setTimeout(() => drawer.classList.add('hidden'), 300);
}

// ── Render ─────────────────────────────────────────────────────
function render() {
  const playlists = getPlaylists();
  const totalTracks = playlists.reduce((s, p) => s + p.tracks.length, 0);

  summary.textContent = playlists.length
    ? `${playlists.length} playlist${playlists.length !== 1 ? 's' : ''} · ${totalTracks} track${totalTracks !== 1 ? 's' : ''}`
    : '';

  if (!playlists.length) {
    list.classList.add('hidden');
    emptyEl.classList.remove('hidden');
    emptyEl.classList.add('flex');
    return;
  }

  list.classList.remove('hidden');
  emptyEl.classList.add('hidden');
  emptyEl.classList.remove('flex');

  list.innerHTML = playlists.map(pl => renderPlaylist(pl)).join('');
  wirePlaylist();
}

function renderPlaylist(pl: Playlist): string {
  const isOpen = expandedId === pl.id;
  const trackCount = pl.tracks.length;

  return `
    <div class="mpd-pl-card rounded-2xl border border-brand-tan bg-brand-parchment/60 overflow-hidden"
         data-pl-id="${esc(pl.id)}">

      <!-- Playlist header row -->
      <div class="flex items-center gap-2 px-3 py-2.5">

        <!-- Expand toggle -->
        <button class="mpd-expand-btn flex-1 min-w-0 flex items-center gap-2 text-left"
                data-id="${esc(pl.id)}" aria-expanded="${isOpen}">
          <svg class="w-4 h-4 shrink-0 fill-brand-slate/50 transition-transform ${isOpen ? 'rotate-90' : ''}"
               viewBox="0 0 24 24">
            <path d="M8 5v14l11-7z"/>
          </svg>
          <span class="min-w-0 flex-1">
            <span class="mpd-pl-name block font-semibold text-brand-navy text-sm truncate">${esc(pl.name)}</span>
            <span class="block text-xs text-brand-slate/50">${trackCount} track${trackCount !== 1 ? 's' : ''} · created ${esc(pl.created)}</span>
          </span>
        </button>

        <!-- Play all -->
        <button class="mpd-play-btn shrink-0 w-8 h-8 flex items-center justify-center
                       rounded-full bg-brand-lotus hover:bg-pink-700 text-white transition-colors
                       ${trackCount === 0 ? 'opacity-40 pointer-events-none' : ''}"
                data-id="${esc(pl.id)}" title="Play playlist" ${trackCount === 0 ? 'disabled' : ''}>
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
        </button>

        <!-- Delete -->
        <button class="mpd-del-btn shrink-0 w-8 h-8 flex items-center justify-center
                       rounded-full text-brand-slate/40 hover:text-red-500 hover:bg-red-50 transition-colors"
                data-id="${esc(pl.id)}" title="Delete playlist">
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zm2.46-7.12l1.41-1.41L12 12.59l2.12-2.12 1.41 1.41L13.41 14l2.12 2.12-1.41 1.41L12 15.41l-2.12 2.12-1.41-1.41L10.59 14l-2.13-2.12zM15.5 4l-1-1h-5l-1 1H5v2h14V4z"/>
          </svg>
        </button>

      </div>

      <!-- Track list (collapsible) -->
      ${isOpen ? `
      <ul class="mpd-track-list border-t border-brand-tan/70 divide-y divide-brand-tan/50">
        ${pl.tracks.length
          ? pl.tracks.map((t, idx) => renderTrackRow(pl.id, t, idx, pl.tracks.length)).join('')
          : `<li class="px-4 py-3 text-xs text-brand-slate/50 italic text-center">No tracks yet.</li>`
        }
      </ul>` : ''}

    </div>`;
}

function renderTrackRow(plId: string, t: PlaylistTrack, idx: number, total: number): string {
  const typeLabel: Record<string, string> = { B: 'Bhajan', S: 'Sloka', N: 'Sankirtan', A: 'Album' };
  return `
    <li class="flex items-center gap-2 px-3 py-2 bg-white/70 hover:bg-white transition-colors">
      <!-- Reorder -->
      <div class="flex flex-col gap-0.5 shrink-0">
        <button class="mpd-up-btn w-5 h-5 flex items-center justify-center rounded
                       text-brand-slate/30 hover:text-brand-navy hover:bg-brand-parchment transition-colors
                       ${idx === 0 ? 'invisible' : ''}"
                data-pl="${esc(plId)}" data-mid="${esc(t.track_id)}" title="Move up">
          <svg class="w-3 h-3 fill-current" viewBox="0 0 24 24"><path d="M7.41 15.41 12 10.83l4.59 4.58L18 14l-6-6-6 6 1.41 1.41z"/></svg>
        </button>
        <button class="mpd-down-btn w-5 h-5 flex items-center justify-center rounded
                       text-brand-slate/30 hover:text-brand-navy hover:bg-brand-parchment transition-colors
                       ${idx === total - 1 ? 'invisible' : ''}"
                data-pl="${esc(plId)}" data-mid="${esc(t.track_id)}" title="Move down">
          <svg class="w-3 h-3 fill-current" viewBox="0 0 24 24"><path d="M7.41 8.59 12 13.17l4.59-4.58L18 10l-6 6-6-6 1.41-1.41z"/></svg>
        </button>
      </div>

      <!-- Track info -->
      <div class="flex-1 min-w-0">
        <p class="text-xs font-semibold text-brand-navy truncate">${esc(t.track_name)}</p>
        <p class="text-[10px] text-brand-slate/50">${typeLabel[t.type] ?? t.type}</p>
      </div>

      <!-- Play single track -->
      <button class="mpd-track-play-btn shrink-0 w-6 h-6 flex items-center justify-center
                     rounded-full bg-brand-parchment hover:bg-brand-lotus hover:text-white
                     text-brand-slate transition-colors"
              data-pl="${esc(plId)}" data-mid="${esc(t.track_id)}" title="Play">
        <svg class="w-3 h-3 fill-current" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
      </button>

      <!-- Remove -->
      <button class="mpd-rm-btn shrink-0 w-6 h-6 flex items-center justify-center
                     rounded-full text-brand-slate/30 hover:text-red-500 hover:bg-red-50 transition-colors"
              data-pl="${esc(plId)}" data-mid="${esc(t.track_id)}" title="Remove from playlist">
        <svg class="w-3 h-3 fill-current" viewBox="0 0 24 24">
          <path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
        </svg>
      </button>
    </li>`;
}

// ── Wire events inside rendered list ──────────────────────────
function wirePlaylist() {
  // Expand / collapse
  list.querySelectorAll<HTMLButtonElement>('.mpd-expand-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const id = btn.dataset.id!;
      expandedId = expandedId === id ? null : id;
      render();
    });
  });

  // Play whole playlist
  list.querySelectorAll<HTMLButtonElement>('.mpd-play-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const pl = getPlaylists().find(p => p.id === btn.dataset.id);
      if (!pl || !pl.tracks.length) return;
      const player = (window as any).__audioPlayer;
      if (player) player.setQueue(pl.tracks, 0);
      close();
    });
  });

  // Delete playlist
  list.querySelectorAll<HTMLButtonElement>('.mpd-del-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const pl = getPlaylists().find(p => p.id === btn.dataset.id);
      if (!pl) return;
      if (!confirm(`Delete "${pl.name}"? This cannot be undone.`)) return;
      if (expandedId === pl.id) expandedId = null;
      deletePlaylist(pl.id);
      window.dispatchEvent(new CustomEvent('playlist-changed'));
      render();
    });
  });

  // Move up
  list.querySelectorAll<HTMLButtonElement>('.mpd-up-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      moveTrack(btn.dataset.pl!, btn.dataset.mid!, 'up');
      window.dispatchEvent(new CustomEvent('playlist-changed'));
      render();
    });
  });

  // Move down
  list.querySelectorAll<HTMLButtonElement>('.mpd-down-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      moveTrack(btn.dataset.pl!, btn.dataset.mid!, 'down');
      window.dispatchEvent(new CustomEvent('playlist-changed'));
      render();
    });
  });

  // Play single track
  list.querySelectorAll<HTMLButtonElement>('.mpd-track-play-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const pl = getPlaylists().find(p => p.id === btn.dataset.pl);
      const track = pl?.tracks.find(t => t.track_id === btn.dataset.mid);
      if (!track) return;
      const player = (window as any).__audioPlayer;
      if (player) player.play(track);
    });
  });

  // Remove track
  list.querySelectorAll<HTMLButtonElement>('.mpd-rm-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      removeTrack(btn.dataset.pl!, btn.dataset.mid!);
      window.dispatchEvent(new CustomEvent('playlist-changed'));
      render();
    });
  });
}

// ── Create new playlist ────────────────────────────────────────
function handleCreate() {
  const name = newName.value.trim();
  if (!name) { newName.focus(); return; }
  createPlaylist(name);
  window.dispatchEvent(new CustomEvent('playlist-changed'));
  newName.value = '';
  expandedId = null;
  render();
}

createBtn.addEventListener('click', handleCreate);
newName.addEventListener('keydown', e => { if (e.key === 'Enter') handleCreate(); });

// ── Close triggers ─────────────────────────────────────────────
closeBtn.addEventListener('click', close);
backdrop.addEventListener('click', close);
document.addEventListener('keydown', e => { if (e.key === 'Escape') close(); });

// ── Open trigger ───────────────────────────────────────────────
window.addEventListener('open-playlist-drawer', open);

// ── Stay in sync when other components change playlists ────────
window.addEventListener('playlist-changed', () => {
  const drawerVisible = !drawer.classList.contains('hidden');
  if (drawerVisible) render();
});

// ── Helpers ────────────────────────────────────────────────────
function esc(s: string) {
  return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}
</script>
