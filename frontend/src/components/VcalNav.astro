---
interface Props { activePath: string; }
const { activePath } = Astro.props;

const tabs = [
  { label: "Calendar",             href: "/vcalendar" },
  { label: "Ekādaśī Guidelines",   href: "/vcalendar/ekadasi-guidelines" },
  { label: "Ekādaśī Recipes",      href: "/vcalendar/ekadasi-recipes" },
];

function isActive(href: string): boolean {
  return href === "/vcalendar"
    ? activePath === "/vcalendar"
    : activePath.startsWith(href);
}
---

<div class="border-b border-brand-tan bg-white">
  <div class="max-w-4xl mx-auto px-4 sm:px-6">
    <nav class="flex gap-1 -mb-px" aria-label="Vaishnava Calendar sections">
      {tabs.map(tab => (
        <a
          href={tab.href}
          class={isActive(tab.href)
            ? "inline-flex items-center px-4 py-3 text-sm font-semibold border-b-2 border-brand-lotus text-brand-lotus whitespace-nowrap"
            : "inline-flex items-center px-4 py-3 text-sm font-semibold border-b-2 border-transparent text-brand-slate hover:text-brand-navy hover:border-brand-tan transition-colors whitespace-nowrap"}
        >
          {tab.label}
        </a>
      ))}
    </nav>
  </div>
</div>
