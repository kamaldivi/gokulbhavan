---
/**
 * AdminShell — layout for all admin pages.
 * Wraps content with sticky sidebar nav + top bar.
 * Includes session check: redirects to /admin if not authenticated.
 */
import Base from "./Base.astro";

interface Props {
  title: string;
  activePath: string;
}

const { title, activePath } = Astro.props;

const NAV = [
  {
    label: "Dashboard",
    href:  "/admin/dashboard",
    icon:  `<path d="M3 13h8V3H3v10zm0 8h8v-6H3v6zm10 0h8V11h-8v10zm0-18v6h8V3h-8z"/>`,
  },
  {
    label: "Announcements",
    href:  "/admin/announcements",
    icon:  `<path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H6l-2 2V4h16v12z"/>`,
  },
  {
    label: "Ask Guruji",
    href:  "/admin/questions",
    icon:  `<path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-7 12h-2v-2h2v2zm0-4h-2V6h2v4z"/>`,
  },
  {
    label: "Audios",
    href:  "/admin/audio",
    icon:  `<path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/>`,
  },
  {
    label: "Slokas",
    href:  "/admin/slokas",
    icon:  `<path d="M4 6H2v14c0 1.1.9 2 2 2h14v-2H4V6zm16-4H8c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H8V4h12v12zM10 9h8v2h-8zm0 3h4v2h-4zm0-6h8v2h-8z"/>`,
  },
  {
    label: "Programs",
    href:  "/admin/programs",
    icon:  `<path d="M19 4h-1V2h-2v2H8V2H6v2H5C3.9 4 3 4.9 3 6v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V10h14v10zm0-12H5V6h14v2z"/>`,
  },
  {
    label: "Registrations",
    href:  "/admin/registrations",
    icon:  `<path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/>`,
  },
  {
    label: "Sanga Info",
    href:  "/admin/sanga",
    icon:  `<path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>`,
  },
  {
    label: "Posts",
    href:  "/admin/posts",
    icon:  `<path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 14H4V8l8 5 8-5v10zm-8-7L4 6h16l-8 5z"/>`,
  },
  {
    label: "Videos",
    href:  "/admin/video-library",
    icon:  `<path d="M17 10.5V7c0-.55-.45-1-1-1H4c-.55 0-1 .45-1 1v10c0 .55.45 1 1 1h12c.55 0 1-.45 1-1v-3.5l4 4v-11l-4 4z"/>`,
  },
];

function isActive(href: string): boolean {
  return activePath === href;
}
---

<Base title={`${title} — Admin`} activePath="/admin">

  <div class="flex min-h-[calc(100vh-theme(spacing.28))]">

    <!-- ── Sidebar ──────────────────────────────────────────── -->
    <aside class="hidden md:flex flex-col w-56 shrink-0 bg-brand-navy border-r border-white/10">

      <div class="px-4 pt-5 pb-3 border-b border-white/10">
        <p class="text-[10px] font-bold uppercase tracking-widest text-white/40">Admin Portal</p>
      </div>

      <nav class="flex-1 px-2 py-3 space-y-0.5">
        {NAV.map(item => (
          <a href={item.href}
             class={isActive(item.href)
               ? "flex items-center gap-3 px-3 py-2.5 rounded-lg bg-white/15 text-white font-semibold text-sm"
               : "flex items-center gap-3 px-3 py-2.5 rounded-lg text-white/60 hover:bg-white/10 hover:text-white font-semibold text-sm transition-colors"}>
            <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24" set:html={item.icon} />
            <span class="flex-1">{item.label}</span>
          </a>
        ))}
      </nav>

    </aside>

    <!-- ── Main area ────────────────────────────────────────── -->
    <div class="flex-1 flex flex-col min-w-0">

      <!-- Top bar -->
      <div class="flex items-center justify-between px-6 py-3 bg-white border-b border-brand-tan">
        <!-- Mobile: hamburger -->
        <button id="admin-menu-toggle"
                class="md:hidden p-1 text-brand-slate hover:text-brand-navy"
                aria-label="Toggle menu">
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z"/></svg>
        </button>
        <p class="font-display font-bold text-brand-navy text-lg">{title}</p>
        <div class="flex items-center gap-3">
          <span id="shell-welcome" class="hidden sm:block text-xs text-brand-slate"></span>
          <a href="/api/auth/logout.php"
             class="inline-flex items-center gap-1.5 text-xs font-semibold text-brand-slate hover:text-brand-navy border border-brand-tan hover:border-brand-navy px-3 py-1.5 rounded-full transition-colors">
            <svg class="w-3 h-3 fill-current" viewBox="0 0 24 24">
              <path d="M17 7l-1.41 1.41L18.17 11H8v2h10.17l-2.58 2.58L17 17l5-5zM4 5h8V3H4c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h8v-2H4V5z"/>
            </svg>
            Sign out
          </a>
        </div>
      </div>

      <!-- Mobile nav drawer -->
      <div id="admin-mobile-nav" class="hidden md:hidden bg-brand-navy px-3 py-2 space-y-0.5">
        {NAV.map(item => (
          <a href={item.href}
             class={isActive(item.href)
               ? "flex items-center gap-3 px-3 py-2.5 rounded-lg bg-white/15 text-white font-semibold text-sm"
               : "flex items-center gap-3 px-3 py-2.5 rounded-lg text-white/60 hover:bg-white/10 hover:text-white font-semibold text-sm transition-colors"}>
            <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24" set:html={item.icon} />
            {item.label}
          </a>
        ))}
      </div>

      <!-- Session check overlay -->
      <div id="shell-checking" class="flex-1 flex items-center justify-center text-brand-slate text-sm">
        Verifying session…
      </div>

      <!-- Page content (revealed after session check) -->
      <div id="shell-content" class="hidden flex-1 px-6 py-8">
        <slot />
      </div>

    </div>
  </div>

</Base>

<script>
  const apiBase = (import.meta as any).env?.VITE_API_BASE_URL ?? '';

  // Session check
  fetch(`${apiBase}/api/auth/session-status.php`)
    .then(r => r.json())
    .then(data => {
      if (!data.authenticated) {
        window.location.href = '/admin?error=session_expired';
        return;
      }
      document.getElementById('shell-checking')!.classList.add('hidden');
      document.getElementById('shell-content')!.classList.remove('hidden');
      const w = document.getElementById('shell-welcome');
      if (w) w.textContent = data.name ?? data.email;

    })
    .catch(() => { window.location.href = '/admin?error=session_expired'; });

  // Mobile menu toggle
  document.getElementById('admin-menu-toggle')
    ?.addEventListener('click', () => {
      document.getElementById('admin-mobile-nav')?.classList.toggle('hidden');
    });
</script>
