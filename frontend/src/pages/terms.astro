---
/**
 * Terms of Use — gokulbhavan.com/terms
 */
import Base from "@layouts/Base.astro";
import PageHero from "@components/PageHero.astro";
const EFFECTIVE = "May 8, 2026";
---

<Base title="Terms of Use" activePath="/terms"
     description="Terms of Use for Gokul Bhavan Gauḍīya Maṭha - guidelines for participating in our programs and using our website.">

  <PageHero
    title="Terms of Use"
    description={`Effective ${EFFECTIVE}`}
  />

  <!-- Content -->
  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-12 divide-y divide-brand-tan">

    <!-- Intro -->
    <section>
      <p class="text-sm text-brand-slate leading-relaxed">
        By using the Gokul Bhavan Gauḍīya Maṭha website (<strong class="text-brand-navy">gokulbhavan.org</strong>)
        or participating in any of our programs, events, or services, you agree to these Terms of Use.
        Please read them carefully. If you do not agree, please do not use our website or programs.
      </p>
    </section>

    <!-- 1 -->
    <section class="py-5">
      <h2 class="font-display font-bold text-lg text-brand-navy mb-1">1. Who We Are</h2>
      <div class="w-8 h-0.5 bg-brand-lotus mb-4"></div>
      <p class="text-sm text-brand-slate leading-relaxed">
        Gokul Bhavan Gauḍīya Maṭha is a registered <strong class="text-brand-navy">501(c)(3) non-profit
        religious organization</strong>. Our purpose is to share the teachings of Śrī Caitanya
        Mahāprabhu and the Gauḍīya Vaiṣṇava tradition for the spiritual benefit of all. We do not
        operate for profit, and all our programs and teachings are offered free of charge.
      </p>
    </section>

    <!-- 2 -->
    <section class="py-5">
      <h2 class="font-display font-bold text-lg text-brand-navy mb-1">2. Free Programs and Services</h2>
      <div class="w-8 h-0.5 bg-brand-lotus mb-4"></div>
      <p class="text-sm text-brand-slate leading-relaxed">
        All classes, teachings, satsaṅgas, hari-kathās, kīrtanas, children's programs, and events
        conducted by Gokul Bhavan are provided <strong class="text-brand-navy">free of cost</strong> to
        all participants. No fee is charged for registration or program attendance. Voluntary
        donations are accepted to support our mission and are separate from participation in any program.
      </p>
    </section>

    <!-- 3 -->
    <section class="py-5">
      <h2 class="font-display font-bold text-lg text-brand-navy mb-1">3. Registration</h2>
      <div class="w-8 h-0.5 bg-brand-lotus mb-4"></div>
      <p class="text-sm text-brand-slate leading-relaxed mb-3">
        By registering with us, you agree to:
      </p>
      <ul class="space-y-2">
        {[
          "Provide accurate and truthful information",
          "Keep your contact details up to date",
          "Use the community resources respectfully and in the spirit of devotional service",
          "Notify us if you wish to update or remove your information",
        ].map((item) => (
          <li class="flex items-start gap-2.5 text-sm text-brand-slate leading-relaxed">
            <span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-brand-lotus shrink-0"></span>
            {item}
          </li>
        ))}
      </ul>
    </section>

    <!-- 4 -->
    <section class="py-5">
      <h2 class="font-display font-bold text-lg text-brand-navy mb-1">4. Community Conduct</h2>
      <div class="w-8 h-0.5 bg-brand-lotus mb-4"></div>
      <p class="text-sm text-brand-slate leading-relaxed mb-3">
        All participants are expected to engage with respect, humility, and sincerity. We ask that you:
      </p>
      <ul class="space-y-2">
        {[
          "Treat all participants, teachers, and coordinators with courtesy and respect",
          "Refrain from disruptive, harmful, or offensive behavior during programs",
          "Respect the devotional and sacred nature of all teachings and practices",
          "Not record or redistribute program content without prior written permission",
        ].map((item) => (
          <li class="flex items-start gap-2.5 text-sm text-brand-slate leading-relaxed">
            <span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-brand-lotus shrink-0"></span>
            {item}
          </li>
        ))}
      </ul>
      <p class="text-sm text-brand-slate leading-relaxed mt-3">
        Gokul Bhavan reserves the right to remove any participant from programs or communication
        channels for conduct that is harmful, disrespectful, or inconsistent with our mission.
      </p>
    </section>

    <!-- 5 -->
    <section class="py-5">
      <h2 class="font-display font-bold text-lg text-brand-navy mb-1">5. Intellectual Property</h2>
      <div class="w-8 h-0.5 bg-brand-lotus mb-4"></div>
      <p class="text-sm text-brand-slate leading-relaxed">
        All content on this website - including text, images, audio, video, and design - is the
        property of Gokul Bhavan Gauḍīya Maṭha or used with permission. You may share links to
        our content freely. You may not copy, reproduce, or redistribute our original content for
        commercial use without written permission. Content from Śrīla Gurudeva's books and
        teachings remains the property of their respective publishers.
      </p>
    </section>

    <!-- 6 -->
    <section class="py-5">
      <h2 class="font-display font-bold text-lg text-brand-navy mb-1">6. No Commercial Use</h2>
      <div class="w-8 h-0.5 bg-brand-lotus mb-4"></div>
      <p class="text-sm text-brand-slate leading-relaxed">
        This website and our programs are provided exclusively for spiritual, educational, and
        community purposes. You may not use our website, content, or community contacts for
        solicitation, advertising, fundraising on behalf of other organizations, or any commercial
        activity without our explicit written consent.
      </p>
    </section>

    <!-- 7 -->
    <section class="py-5">
      <h2 class="font-display font-bold text-lg text-brand-navy mb-1">7. Donations</h2>
      <div class="w-8 h-0.5 bg-brand-lotus mb-4"></div>
      <p class="text-sm text-brand-slate leading-relaxed">
        Gokul Bhavan Gauḍīya Maṭha is a 501(c)(3) non-profit organization. Donations are voluntary
        and <strong class="text-brand-navy">tax-deductible to the extent permitted by law</strong>.
        Donations support our outreach, prison ministry, children's programs, and community
        activities. No goods or services are provided in exchange for donations unless otherwise
        stated.
      </p>
    </section>

    <!-- 8 -->
    <section class="py-5">
      <h2 class="font-display font-bold text-lg text-brand-navy mb-1">8. External Links</h2>
      <div class="w-8 h-0.5 bg-brand-lotus mb-4"></div>
      <p class="text-sm text-brand-slate leading-relaxed">
        Our website may contain links to external sites such as YouTube, Facebook, Zoom, or
        affiliated devotional resources. We are not responsible for the content or privacy
        practices of those sites and encourage you to review their policies independently.
      </p>
    </section>

    <!-- 9 -->
    <section class="py-5">
      <h2 class="font-display font-bold text-lg text-brand-navy mb-1">9. Disclaimer</h2>
      <div class="w-8 h-0.5 bg-brand-lotus mb-4"></div>
      <p class="text-sm text-brand-slate leading-relaxed">
        The teachings, guidance, and content shared through Gokul Bhavan programs are for spiritual
        and educational purposes. They do not constitute professional legal, medical, financial, or
        psychological advice. We make no warranties regarding the completeness or accuracy of
        information presented and are not liable for any decisions made based on our content.
      </p>
    </section>

    <!-- 10 -->
    <section class="py-5">
      <h2 class="font-display font-bold text-lg text-brand-navy mb-1">10. Changes to These Terms</h2>
      <div class="w-8 h-0.5 bg-brand-lotus mb-4"></div>
      <p class="text-sm text-brand-slate leading-relaxed">
        We may update these Terms from time to time. Changes will be posted on this page with a
        revised effective date. Continued use of our website or programs after changes are posted
        constitutes your acceptance of the updated terms.
      </p>
    </section>

    <!-- 11 -->
    <section class="py-5">
      <h2 class="font-display font-bold text-lg text-brand-navy mb-1">11. Contact</h2>
      <div class="w-8 h-0.5 bg-brand-lotus mb-4"></div>
      <p class="text-sm text-brand-slate leading-relaxed">
        Questions about these Terms may be directed to:
      </p>
      <div class="mt-4 bg-brand-linen border border-brand-tan rounded-xl px-5 py-4 text-sm text-brand-slate space-y-1">
        <p class="font-semibold text-brand-navy">Gokul Bhavan Gauḍīya Maṭha</p>
        <p>41901 White Mountain Ct, Aldie, VA 20105, USA</p>
        <p>
          Email:{" "}
          <a href="mailto:bkdasa@gmail.com" class="text-brand-lotus font-semibold hover:underline">bkdasa@gmail.com</a>
        </p>
      </div>
    </section>

  </div>

</Base>
