---
/**
 * Tamil page — gokulbhavan.org/tamil
 * Gitamrita (கீதா அமுதம்) program info + Tamil video strip.
 * Uses the standard main-site navigation.
 */
import Base from "@layouts/Base.astro";
import FeaturedVideos from "@components/FeaturedVideos.astro";
---

<Base
