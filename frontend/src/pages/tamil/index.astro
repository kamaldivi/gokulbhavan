  activePath="/tamil"
>

  <!-- Hero banner — Gitamrita launch -->
  <section class="relative w-full bg-brand-navy" style="min-height: 460px;" aria-label="Gitamrita launch banner">
    <div class="absolute inset-0 bg-cover bg-center"
         style="background-image: url('/assets/gb_banner_tamil.png');" aria-hidden="true"></div>
    <!-- Gradient: light at top (preserve image sky), dark at bottom (text legibility) -->
