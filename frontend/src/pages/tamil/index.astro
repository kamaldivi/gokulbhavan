---
/**
 * Tamil Sangha home page — gokulbhavan.com/tamil/
 * Gitamrita (கீதா அமுதம்) launch banner + program overview.
 * Nav labels are in Tamil; shared Header/Footer components used.
 */
import Base from "@layouts/Base.astro";

const TAMIL_NAV = [
  { label: "முகப்பு",        href: "/tamil" },
  { label: "நிகழ்ச்சிகள்",  href: "/tamil/programs" },
  { label: "பஜன்கள்",       href: "/tamil/bhajans" },
  { label: "ஸ்லோகங்கள்",   href: "/tamil/slokas" },
  { label: "ஹரிகதைகள்",    href: "/tamil/harikathas" },
  { label: "சங்கீர்த்தன்", href: "/tamil/sankirtans" },
];
---

<Base
  title="தமிழ் சங்கம் | Gokul Bhavan"
  description="கீதா அமுதம் — A weekly Tamil Bhagavad-Gita study program by Gokul Bhavan Gaudiya Matha."
  activePath="/tamil"
  navItems={TAMIL_NAV}
>

  <!-- Hero banner — Gitamrita launch -->
  <section class="relative w-full bg-brand-navy" style="min-height: 460px;" aria-label="Gitamrita launch banner">
    <div class="absolute inset-0 bg-cover bg-center"
         style="background-image: url('/assets/gb_banner_tamil.png');" aria-hidden="true"></div>
    <!-- Gradient: light at top (preserve image sky), dark at bottom (text legibility) -->
    <div class="absolute inset-0"
         style="background: linear-gradient(to bottom, rgba(0,0,0,0.35) 0%, rgba(0,0,0,0.85) 100%);"
         aria-hidden="true"></div>

    <div class="relative z-10 flex flex-col items-center justify-end text-center px-6 pb-12"
         style="min-height: 460px;">

      <!-- Launch badge -->
      <span class="inline-block bg-brand-lotus text-white text-[11px] font-bold uppercase tracking-widest px-4 py-1 rounded-full mb-5 shadow">
        விரைவில் தொடங்குகிறது · Launching Soon
      </span>

      <!-- Tamil title -->
      <p class="font-tamil text-brand-gold text-2xl md:text-3xl font-semibold mb-1 drop-shadow">
        கீதா அமுதம்
      </p>

      <!-- English title -->
      <h1 class="font-display font-bold text-3xl md:text-4xl lg:text-5xl text-white leading-tight mb-3 drop-shadow-md">
        Gita Amrutam
      </h1>

      <!-- Tagline -->
      <p class="font-tamil text-white/85 text-base md:text-lg italic mb-1 drop-shadow">
        கீதையைக் கேட்போம் · அதன் பாதையில் நடப்போம்
      </p>
      <p class="text-white/70 text-sm mb-6 drop-shadow">
        "Let us hear the Gita and walk on its path"
      </p>

      <!-- Program snapshot -->
      <div class="flex flex-wrap items-center justify-center gap-3 mb-7 text-xs font-semibold text-white/80">
        <span class="bg-white/15 backdrop-blur px-3 py-1.5 rounded-full">📅 Every Friday</span>
        <span class="bg-white/15 backdrop-blur px-3 py-1.5 rounded-full">🇮🇳 8:00 PM IST</span>
        <span class="bg-white/15 backdrop-blur px-3 py-1.5 rounded-full">🇺🇸 9:30 AM CST · 10:30 AM EST</span>
        <span class="bg-white/15 backdrop-blur px-3 py-1.5 rounded-full">⏱ 95 minutes</span>
      </div>

      <!-- CTAs -->
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href="/register"
           class="inline-flex items-center justify-center bg-brand-lotus hover:bg-pink-700 text-white font-semibold px-7 py-3 rounded-full transition-colors shadow">
          பதிவு செய்யுங்கள் · Register
        </a>
        <a href="/tamil/programs"
           class="inline-flex items-center justify-center border-2 border-white text-white hover:bg-white hover:text-brand-navy font-semibold px-7 py-3 rounded-full transition-colors">
          நிகழ்ச்சிகள் காண · Explore Programs
        </a>
      </div>

    </div>
  </section>

  <!-- Program overview -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 py-14">

    <div class="text-center mb-10">
      <h2 class="font-display font-bold text-3xl text-brand-navy mb-2">
        About <span class="text-brand-lotus">கீதா அமுதம்</span>
      </h2>
      <p class="text-brand-slate text-sm max-w-2xl mx-auto leading-relaxed">
        A weekly Tamil spiritual study program focused on listening to the timeless message of the
        Bhagavad-Gita and applying its teachings in daily life — in the Gauḍīya Sampradāya tradition.
      </p>
    </div>

    <!-- Detail cards -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-5 mb-10">

      <div class="bg-brand-linen border border-brand-tan rounded-xl p-6 text-center shadow-sm">
        <div class="text-3xl mb-3">📖</div>
        <h3 class="font-display font-bold text-brand-navy mb-1">Weekly Study</h3>
        <p class="text-xs text-brand-slate leading-relaxed">
          Systematic study of the Bhagavad-Gita with commentary from the Gauḍīya Sampradāya.
        </p>
      </div>

      <div class="bg-brand-linen border border-brand-tan rounded-xl p-6 text-center shadow-sm">
        <div class="text-3xl mb-3">🎵</div>
        <h3 class="font-display font-bold text-brand-navy mb-1">Kirtan & Sankirtanam</h3>
        <p class="text-xs text-brand-slate leading-relaxed">
          Each session opens and closes with devotional kirtan and Tamil bhajans.
        </p>
      </div>

      <div class="bg-brand-linen border border-brand-tan rounded-xl p-6 text-center shadow-sm">
        <div class="text-3xl mb-3">💬</div>
        <h3 class="font-display font-bold text-brand-navy mb-1">Q&amp;A &amp; Satsang</h3>
        <p class="text-xs text-brand-slate leading-relaxed">
          15 minutes of open questions and community satsang after each discourse.
        </p>
      </div>

    </div>

    <!-- Session schedule -->
    <div class="bg-brand-navy rounded-2xl p-7 text-white">
      <h3 class="font-display font-bold text-lg text-brand-gold mb-4">Session Flow — 95 Minutes</h3>
      <ol class="space-y-2.5 text-sm">
        <li class="flex items-start gap-3">
          <span class="w-6 h-6 rounded-full bg-brand-lotus flex items-center justify-center text-xs font-bold shrink-0">1</span>
          <span><strong class="text-white">Opening Prayers &amp; Kirtan</strong> <span class="text-white/60">— 10 min</span></span>
        </li>
        <li class="flex items-start gap-3">
          <span class="w-6 h-6 rounded-full bg-brand-lotus flex items-center justify-center text-xs font-bold shrink-0">2</span>
          <span><strong class="text-white">Gita Discourse</strong> <span class="text-white/60">— 60 min</span></span>
        </li>
        <li class="flex items-start gap-3">
          <span class="w-6 h-6 rounded-full bg-brand-lotus flex items-center justify-center text-xs font-bold shrink-0">3</span>
          <span><strong class="text-white">Sankirtanam</strong> <span class="text-white/60">— 5 min</span></span>
        </li>
        <li class="flex items-start gap-3">
          <span class="w-6 h-6 rounded-full bg-brand-lotus flex items-center justify-center text-xs font-bold shrink-0">4</span>
          <span><strong class="text-white">Questions &amp; Satsang</strong> <span class="text-white/60">— 15 min</span></span>
        </li>
        <li class="flex items-start gap-3">
          <span class="w-6 h-6 rounded-full bg-brand-lotus flex items-center justify-center text-xs font-bold shrink-0">5</span>
          <span><strong class="text-white">Announcements</strong> <span class="text-white/60">— 5 min</span></span>
        </li>
      </ol>

      <div class="mt-6 pt-5 border-t border-white/15 grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
        <div>
          <p class="text-white/50 text-xs uppercase tracking-widest mb-1">Join via Zoom</p>
          <a href="https://zoom.us/j/2294369627" target="_blank" rel="noopener noreferrer"
             class="font-mono font-semibold text-brand-gold hover:underline">
            Meeting ID: 229 436 9627
          </a>
          <p class="text-white/50 text-xs mt-0.5">Passcode: 108</p>
        </div>
        <div>
          <p class="text-white/50 text-xs uppercase tracking-widest mb-1">Teacher</p>
          <p class="font-semibold text-white">Dr. Bhagavati Kanti</p>
          <p class="text-white/60 text-xs">M.Tech (IIT) · Ph.D</p>
        </div>
      </div>
    </div>

  </section>

</Base>
