         style="background: linear-gradient(to bottom, rgba(0,0,0,0.35) 0%, rgba(0,0,0,0.85) 100%);"
         aria-hidden="true"></div>

    <div class="relative z-10 flex flex-col items-center justify-end text-center px-6 pb-12"
         style="min-height: 460px;">

      <!-- Launch badge -->
      <span class="inline-block bg-brand-lotus text-white text-[11px] font-bold uppercase tracking-widest px-4 py-1 rounded-full mb-5 shadow">
        விரைவில் தொடங்குகிறது · Launching Soon
      </span>

      <!-- Tamil title -->
      <p class="font-tamil text-brand-gold text-2xl md:text-3xl font-semibold mb-1 drop-shadow">
        கீதா அமுதம்
      </p>

      <!-- English title -->
      <h1 class="font-display font-bold text-3xl md:text-4xl lg:text-5xl text-white leading-tight mb-3 drop-shadow-md">
        Gita Amutham
      </h1>

      <!-- Tagline -->
      <p class="font-tamil text-white/85 text-base md:text-lg italic mb-1 drop-shadow">
        கீதையைக் கேட்போம் · அதன் பாதையில் நடப்போம்
      </p>
      <p class="text-white/70 text-sm mb-6 drop-shadow">
        "Let us hear the Gita and walk on its path"
      </p>

      <!-- Program snapshot -->
      <div class="flex flex-wrap items-center justify-center gap-3 mb-7 text-xs font-semibold text-white/80">
        <span id="tamil-day-chip" class="bg-white/15 backdrop-blur px-3 py-1.5 rounded-full">📅 Every Friday</span>
        <span id="tamil-time-chip" class="bg-white/15 backdrop-blur px-3 py-1.5 rounded-full">🕐 10:30 AM EST</span>
        <span class="bg-white/15 backdrop-blur px-3 py-1.5 rounded-full">⏱ 95 minutes</span>
      </div>

      <!-- CTAs -->
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href="/register"
           class="inline-flex items-center justify-center bg-brand-lotus hover:bg-pink-700 text-white font-semibold px-7 py-3 rounded-full transition-colors shadow">
          பதிவு செய்யுங்கள் · Register
