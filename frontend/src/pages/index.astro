---
/**
 * Home page — gokulbhavan.com/
 * Hero banner + feature sections.
 * Dynamic content (events, programs) loaded client-side from Flask API.
 */
import Base from "@layouts/Base.astro";
---

<Base title="Home" activePath="/">

  <!-- Hero banner -->
  <section class="relative w-full bg-brand-navy" style="min-height: 420px;" aria-label="Welcome banner">
    <div class="absolute inset-0 bg-cover bg-center"
         style="background-image: url('/assets/gb_banner.png');" aria-hidden="true"></div>
    <div class="absolute inset-0"
         style="background: linear-gradient(to bottom, transparent 30%, rgba(0,0,0,0.82) 100%);"
         aria-hidden="true"></div>
    <div class="relative z-10 flex flex-col items-center justify-end text-center px-6 pb-10"
         style="min-height: 420px;">
      <h1 class="font-display font-bold text-3xl md:text-4xl lg:text-5xl text-white leading-tight mb-3 drop-shadow-md">
        Welcome to Gokul Bhavan
      </h1>
      <p class="text-white/90 text-base md:text-lg leading-relaxed mb-6 max-w-2xl font-sans drop-shadow">
        Your path to Rāgānugā Bhakti — Seek the truth, Nurture under Guru, Immerse in sādhana
        per the Gauḍīya Sampradāya, and strive to attain Goloka.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center flex-wrap">
        <a href="/programs"
           class="inline-flex items-center justify-center bg-brand-lotus hover:bg-pink-700 text-white font-semibold px-7 py-3 rounded-full transition-colors shadow">
          Explore Programs
        </a>
        <a href="/register"
           class="inline-flex items-center justify-center border-2 border-white text-white hover:bg-white hover:text-brand-navy font-semibold px-7 py-3 rounded-full transition-colors">
          Register
        </a>
      </div>
    </div>
  </section>

  <!-- Upcoming events (loaded from API) -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 py-14">
    <h2 class="font-display font-bold text-3xl text-brand-navy mb-2">Upcoming Events</h2>
    <p class="text-brand-slate text-sm mb-8">Join us for our upcoming programs and special events.</p>
    <div id="events-grid" class="grid grid-cols-1 md:grid-cols-3 gap-5">
      <!-- Populated by client-side script -->
      <p class="text-brand-slate text-sm col-span-3">Loading events…</p>
    </div>
  </section>

</Base>

<script>
  import { getEvents } from "@lib/api";
  import type { CalendarEvent } from "@lib/api";

  const grid = document.getElementById("events-grid")!;

  getEvents("gokulbhavan")
    .then((events: CalendarEvent[]) => {
      if (events.length === 0) {
        grid.innerHTML = `<p class="text-brand-slate text-sm col-span-3">No upcoming events. Check back soon.</p>`;
        return;
      }
      grid.innerHTML = events.map((e) => `
        <article class="bg-brand-linen rounded-xl border border-brand-tan p-6 shadow-sm">
          <p class="text-[11px] font-semibold uppercase tracking-widest text-brand-slate mb-2">${e.date}</p>
          <h3 class="font-display font-bold text-lg text-brand-navy mb-1">${e.title}</h3>
          <p class="text-sm text-brand-slate leading-relaxed mb-3">${e.description}</p>
          <p class="text-sm font-semibold text-brand-cobalt">${e.time} · ${e.location}</p>
        </article>
      `).join("");
    })
    .catch(() => {
      grid.innerHTML = `<p class="text-brand-slate text-sm col-span-3">Could not load events.</p>`;
    });
</script>
