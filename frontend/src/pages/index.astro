---
/**
 * Home page — gokulbhavan.com/
 * Hero banner + feature sections.
 * Dynamic content (events, programs) loaded client-side from Flask API.
 */
import Base from "@layouts/Base.astro";
import FeaturedVideos from "@components/FeaturedVideos.astro";
---

<Base title="Home" activePath="/">

  <!-- Hero banner -->
  <section class="relative w-full bg-brand-navy" style="min-height: 420px;" aria-label="Welcome banner">
    <div class="absolute inset-0 bg-cover bg-center"
         style="background-image: url('/assets/gb_banner.png');" aria-hidden="true"></div>
    <div class="absolute inset-0"
         style="background: linear-gradient(to bottom, transparent 30%, rgba(0,0,0,0.82) 100%);"
         aria-hidden="true"></div>
    <div class="relative z-10 flex flex-col items-center justify-end text-center px-6 pb-10"
         style="min-height: 420px;">

      <p class="text-white/80 text-base md:text-lg leading-relaxed mb-6 max-w-2xl font-sans drop-shadow">
        Welcome to Gokul Bhavan - Seek, Nurture, Immerse & Attain
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center flex-wrap">
        <a href="/programs"
           class="inline-flex items-center justify-center bg-brand-lotus hover:bg-pink-700 text-white font-semibold px-7 py-3 rounded-full transition-colors shadow">
          Explore Programs
        </a>
        <a href="/register"
           class="inline-flex items-center justify-center border-2 border-white text-white hover:bg-white hover:text-brand-navy font-semibold px-7 py-3 rounded-full transition-colors">
          Register
        </a>
      </div>
    </div>
  </section>

  <!-- ── Highlights ────────────────────────────────────────────── -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 py-14" aria-label="Site highlights">

    <div class="text-center mb-8">
      <p class="text-[11px] font-bold uppercase tracking-widest text-brand-lotus mb-2">What's Happening</p>
      <h2 class="font-display font-bold text-3xl text-brand-navy">News & Highlights</h2>
    </div>

    <!-- ── Announcements — full width, between title and cards ── -->
    <div id="ann-section" class="hidden mb-8">
      <div class="flex items-center gap-2 mb-3">
        <!-- Megaphone / campaign icon -->
        <svg class="w-4 h-4 fill-current text-brand-lotus shrink-0" viewBox="0 0 24 24">
          <path d="M18 11v2h4v-2h-4zm-2 6.61c.96.71 2.21 1.65 3.2 2.39.4-.53.8-1.07 1.2-1.6-.99-.74-2.24-1.68-3.2-2.4-.4.54-.8 1.08-1.2 1.61zM20.4 5.6c-.4-.53-.8-1.07-1.2-1.6-.99.74-2.24 1.68-3.2 2.4.4.53.8 1.07 1.2 1.6.96-.72 2.21-1.65 3.2-2.4zM4 9c-1.1 0-2 .9-2 2v2c0 1.1.9 2 2 2h1v4h2v-4h1l5 3V6L8 9H4zm11.5 3c0-1.33-.58-2.53-1.5-3.35v6.69c.92-.81 1.5-2.01 1.5-3.34z"/>
        </svg>
        <p class="text-[11px] font-bold uppercase tracking-widest text-brand-lotus">Announcements</p>
      </div>
      <div id="ann-cards" class="space-y-3"></div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">

      <!-- 1 · Pure Bhakti Base mobile app ─────────────────── -->
      <div class="group relative rounded-2xl overflow-hidden border border-brand-tan bg-gradient-to-br from-brand-navy to-brand-slate shadow-sm hover:shadow-lg transition-shadow flex flex-col min-h-56">
        <div class="absolute top-0 right-0 w-40 h-40 rounded-full bg-white/5 -translate-y-12 translate-x-12"></div>
        <div class="relative z-10 flex flex-col flex-1 p-7">
          <span class="inline-flex items-center self-start gap-1.5 bg-brand-lotus text-white text-[10px] font-bold uppercase tracking-widest px-3 py-1 rounded-full mb-4">
            <svg class="w-3 h-3 fill-current" viewBox="0 0 24 24"><path d="M17 1.01L7 1c-1.1 0-2 .9-2 2v18c0 1.1.9 2 2 2h10c1.1 0 2-.9 2-2V3c0-1.1-.9-1.99-2-1.99zM17 19H7V5h10v14z"/></svg>
            Mobile App
          </span>
          <h3 class="font-display font-bold text-xl text-white mb-2 leading-snug">
            Join us on Mobile
          </h3>
          <p class="text-white/70 text-base leading-relaxed flex-1">
            Read Śrīla Gurudeva's teachings and Gokul Bhavan's spiritual books -
            available on iOS and Android.
          </p>
          <div class="mt-5 flex flex-col sm:flex-row gap-2">
            <a href="https://apps.apple.com/us/app/pure-bhakti-base-mobile/id6761331962"
               target="_blank" rel="noopener noreferrer"
               class="inline-flex items-center gap-2 bg-white/15 hover:bg-white/25 border border-white/20 text-white text-sm font-semibold px-4 py-2.5 rounded-lg transition-colors">
              <svg class="w-4 h-4 fill-white shrink-0" viewBox="0 0 24 24"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/></svg>
              App Store
            </a>
            <a href="https://play.google.com/store/apps/details?id=com.purebhaktibase.mobile"
               target="_blank" rel="noopener noreferrer"
               class="inline-flex items-center gap-2 bg-white/15 hover:bg-white/25 border border-white/20 text-white text-sm font-semibold px-4 py-2.5 rounded-lg transition-colors">
              <svg class="w-4 h-4 fill-white shrink-0" viewBox="0 0 24 24"><path d="M3.18 23.76c.3.17.64.22.99.14l12.24-6.99-2.76-2.76-10.47 9.61zM.22 1.4A1.27 1.27 0 0 0 0 2.06v19.88c0 .24.07.46.22.65l.11.1 11.14-11.14v-.26L.33 1.3.22 1.4zM20.54 10.7l-2.81-1.6-3.09 3.09 3.09 3.09 2.84-1.62c.81-.46.81-1.21-.03-1.96zM3.18.24L15.42 7.2l-2.76 2.76L2.19.34c.29-.17.65-.2.99-.1z"/></svg>
              Google Play
            </a>
          </div>
        </div>
      </div>

      <!-- 3 · 108 Tunes ─────────────────────────────────────── -->
      <a href="/sankirtans"
         class="group relative rounded-2xl overflow-hidden border border-brand-tan bg-white shadow-sm hover:shadow-lg transition-shadow flex flex-col min-h-56">
        <div class="relative z-10 flex flex-col flex-1 p-7">
          <span class="inline-block self-start bg-brand-navy text-white text-xs font-bold uppercase tracking-widest px-3 py-1 rounded-full mb-4">
            Gokul Kids Initiative
          </span>
          <h3 class="font-display font-bold text-xl text-brand-navy mb-3 leading-snug">
            108 Nāma-Saṅkīrtana Tunes
          </h3>

          <!-- Progress bar -->
          <div class="mb-3">
            <div class="flex justify-between text-sm font-semibold text-brand-slate mb-1.5">
              <span>Progress</span>
              <span class="text-brand-lotus">88 of 108 completed</span>
            </div>
            <div class="h-3 bg-brand-tan rounded-full overflow-hidden">
              <div class="h-full rounded-full bg-gradient-to-r from-brand-lotus to-pink-400 transition-all"
                   style="width: 81.5%"></div>
            </div>
            <div class="flex justify-between text-xs text-brand-slate/60 mt-1">
              <span>0</span>
              <span>108</span>
            </div>
          </div>

          <p class="text-brand-slate text-base leading-relaxed flex-1">
            Gokul Bhavan children are composing 108 unique tunes for Nāma-Saṅkīrtana.
            88 tunes are complete - listen to all recordings on the Saṅkīrtans page.
          </p>
          <div class="mt-5 flex items-center gap-2 text-brand-navy text-base font-semibold group-hover:gap-3 transition-all">
            Listen to Saṅkīrtans
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6z"/></svg>
          </div>
        </div>
      </a>

    </div>
  </section>
  
  <!-- Latest Videos strip -->
  <div class="max-w-6xl mx-auto px-4 sm:px-6 border-t border-brand-tan">
    <FeaturedVideos
      id="home-latest"
      title="Latest Videos"
      apiParams="limit=5&sort=published_date"
      moreLink="/videos"
      moreLinkLabel="Browse all videos →"
      mode="strip"
    />
  </div>
</Base>

<script>
(function () {
  type Announcement = {
    id: number;
    title: string;
    body: string | null;
    url: string | null;
    start_date: string | null;
    end_date: string | null;
  };

  const apiBase  = (import.meta as any).env?.VITE_API_BASE_URL ?? '';
  const section  = document.getElementById('ann-section')!;
  const cardsEl  = document.getElementById('ann-cards')!;

  function esc(s: string) {
    return String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  }

  async function load() {
    try {
      const res = await fetch(`${apiBase}/api/announcements.php`);
      if (!res.ok) return;
      const anns: Announcement[] = await res.json();
      if (!anns.length) return;

      cardsEl.innerHTML = anns.map(a => {
        return `
          <div class="rounded-xl border border-amber-200 bg-amber-50 px-5 py-4 flex items-start gap-4">
            <div class="min-w-0 flex-1">
              <p class="font-semibold text-base text-brand-navy leading-snug">${esc(a.title)}</p>
              ${a.body ? `<p class="text-sm text-brand-slate leading-relaxed mt-1">${esc(a.body)}</p>` : ''}
            </div>
            ${a.url ? `
            <a href="${esc(a.url)}" target="_blank" rel="noopener noreferrer"
               class="shrink-0 inline-flex items-center gap-1.5 bg-brand-lotus hover:bg-pink-700
                      text-white text-sm font-semibold px-4 py-2 rounded-full transition-colors whitespace-nowrap">
              Learn more
              <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6z"/></svg>
            </a>` : ''}
          </div>`;
      }).join('');

      section.classList.remove('hidden');
    } catch {
      // silently ignore — announcements are non-critical
    }
  }

  load();
})();
</script>

