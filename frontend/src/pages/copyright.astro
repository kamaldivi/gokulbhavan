---
/**
 * Copyright & Credits — gokulbhavan.org/copyright
 */
import Base from "@layouts/Base.astro";
import PageHero from "@components/PageHero.astro";
const EFFECTIVE = "June 11, 2026";
---

<Base title="Copyright & Credits" activePath="/copyright"
     description="Copyright notices and content credits for Gokul Bhavan Gauḍīya Maṭha — website, artwork, books, calendar data, and audio recordings.">

  <PageHero
    title="Copyright & Credits"
    description={`Effective ${EFFECTIVE}`}
  />

  <!-- Content -->
  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-12 divide-y divide-brand-tan">

    <!-- Intro -->
    <section>
      <p class="text-sm text-brand-slate leading-relaxed">
        Gokul Bhavan Gauḍīya Maṭha (<strong class="text-brand-navy">"Gokul Bhavan," "we," "us"</strong>)
        is grateful to the many individuals and organizations whose work enriches this site.
        This page identifies the copyright holders for all content categories and provides
        attribution where required. If you have questions about the use or licensing of any
        material, please contact us before reproducing it.
      </p>
    </section>

    <!-- 1 -->
    <section class="py-5">
      <h2 class="font-display font-bold text-lg text-brand-navy mb-1">1. Website Content &amp; Code</h2>
      <div class="w-8 h-0.5 bg-brand-lotus mb-4"></div>
      <p class="text-sm text-brand-slate leading-relaxed">
        All original text, page design, layout, and source code on
        <strong class="text-brand-navy">gokulbhavan.org</strong> is
        &copy; Gokul Bhavan Gauḍīya Maṭha, 2024–present. All rights reserved.
        You may share links to pages on this site freely. You may not copy, reproduce,
        or redistribute original site content without prior written permission.
      </p>
    </section>

    <!-- 2 -->
    <section class="py-5">
      <h2 class="font-display font-bold text-lg text-brand-navy mb-1">2. Devotional Artwork</h2>
      <div class="w-8 h-0.5 bg-brand-lotus mb-4"></div>
      <p class="text-sm text-brand-slate leading-relaxed mb-3">
        Devotional paintings and illustrations reproduced on this website — including
        deity artwork and devotional scenes — are:
      </p>
      <div class="bg-brand-linen border border-brand-tan rounded-xl px-5 py-4 text-sm text-brand-slate space-y-1 mb-3">
        <p><strong class="text-brand-navy">&copy; Śyāmaraṇī Dāsī</strong> — All artwork rights reserved.</p>
        <p class="text-brand-slate/80">Used on this site with the artist's permission.</p>
      </div>
      <p class="text-sm text-brand-slate leading-relaxed">
        This artwork may not be downloaded, reproduced, printed, or redistributed in any
        form without direct written permission from the artist.
      </p>
    </section>

    <!-- 3 -->
    <section class="py-5">
      <h2 class="font-display font-bold text-lg text-brand-navy mb-1">3. Books &amp; Written Teachings</h2>
      <div class="w-8 h-0.5 bg-brand-lotus mb-4"></div>
      <p class="text-sm text-brand-slate leading-relaxed mb-3">
        Books, commentaries, translations, and written teachings referenced or excerpted
        on this site are published by:
      </p>
      <div class="bg-brand-linen border border-brand-tan rounded-xl px-5 py-4 text-sm text-brand-slate space-y-1 mb-3">
        <p><strong class="text-brand-navy">&copy; Gauḍīya Vedānta Publications (GVP)</strong></p>
        <p class="text-brand-slate/80">Some book content rights reserved.</p>
      </div>
      <p class="text-sm text-brand-slate leading-relaxed">
        These works — including the writings of Yuga-ācārya Śrīla Bhaktivedānta
        Nārāyaṇa Gosvāmī Mahārāja — may not be reproduced, distributed, or sold without
        authorization from Gauḍīya Vedānta Publications. Links to authorized editions are
        provided where available.
      </p>
    </section>

    <!-- 4 -->
    <section class="py-5">
      <h2 class="font-display font-bold text-lg text-brand-navy mb-1">4. Vaiṣṇava Calendar Information</h2>
      <div class="w-8 h-0.5 bg-brand-lotus mb-4"></div>
      <p class="text-sm text-brand-slate leading-relaxed mb-3">
        Vaiṣṇava calendar data displayed on this site — including Ekādaśī dates,
        observance guidelines, fasting details, and pañcāṅga information — is sourced from:
      </p>
      <div class="bg-brand-linen border border-brand-tan rounded-xl px-5 py-4 text-sm text-brand-slate space-y-1 mb-3">
        <p><strong class="text-brand-navy">purebhakti.com</strong></p>
        <p class="text-brand-slate/80">
          <a href="https://www.purebhakti.com" target="_blank" rel="noopener noreferrer"
             class="text-brand-lotus hover:underline">www.purebhakti.com</a>
        </p>
      </div>
      <p class="text-sm text-brand-slate leading-relaxed">
        Calendar content is presented for the spiritual benefit of our community.
        For the authoritative and most current calendar data, please refer directly
        to purebhakti.com.
      </p>
    </section>

    <!-- 5 -->
    <section class="py-5">
      <h2 class="font-display font-bold text-lg text-brand-navy mb-1">5. Audio Recordings</h2>
      <div class="w-8 h-0.5 bg-brand-lotus mb-4"></div>
      <p class="text-sm text-brand-slate leading-relaxed">
        Bhajan, saṅkīrtana, śloka, and lecture audio recordings produced by Gokul Bhavan
        are &copy; Gokul Bhavan Gauḍīya Maṭha. Traditional compositions and scriptural
        texts are in the public domain; the specific recordings, arrangements, and
        productions are the intellectual property of Gokul Bhavan. These recordings
        may not be redistributed or used commercially without written permission.
      </p>
    </section>

    <!-- 6 -->
    <section class="py-5">
      <h2 class="font-display font-bold text-lg text-brand-navy mb-1">6. Third-Party Marks &amp; Assets</h2>
      <div class="w-8 h-0.5 bg-brand-lotus mb-4"></div>
      <p class="text-sm text-brand-slate leading-relaxed mb-3">
        References to third-party services and their logos are the property of their
        respective owners:
      </p>
      <ul class="space-y-2">
        {[
          "YouTube is a trademark of Google LLC.",
          "Zoom is a trademark of Zoom Video Communications, Inc.",
          "Apple App Store and the Apple logo are trademarks of Apple Inc.",
          "Google Play and the Google Play logo are trademarks of Google LLC.",
        ].map((item) => (
          <li class="flex items-start gap-2.5 text-sm text-brand-slate leading-relaxed">
            <span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-brand-lotus shrink-0"></span>
            {item}
          </li>
        ))}
      </ul>
      <p class="text-sm text-brand-slate leading-relaxed mt-3">
        Mention of these services does not imply endorsement by or affiliation with
        their respective owners.
      </p>
    </section>

    <!-- 7 -->
    <section class="py-5">
      <h2 class="font-display font-bold text-lg text-brand-navy mb-1">7. Requesting Permission</h2>
      <div class="w-8 h-0.5 bg-brand-lotus mb-4"></div>
      <p class="text-sm text-brand-slate leading-relaxed">
        For permission to reproduce, redistribute, or adapt any content from this website,
        please write to us describing the specific material, the intended use, and the
        audience. We will do our best to respond promptly and direct you to the appropriate
        rights holder where necessary.
      </p>
    </section>

    <!-- 8 -->
    <section class="py-5">
      <h2 class="font-display font-bold text-lg text-brand-navy mb-1">8. Contact</h2>
      <div class="w-8 h-0.5 bg-brand-lotus mb-4"></div>
      <p class="text-sm text-brand-slate leading-relaxed">
        Copyright and credits inquiries may be directed to:
      </p>
      <div class="mt-4 bg-brand-linen border border-brand-tan rounded-xl px-5 py-4 text-sm text-brand-slate space-y-1">
        <p class="font-semibold text-brand-navy">Gokul Bhavan Gauḍīya Maṭha</p>
        <p>41901 White Mountain Ct, Aldie, VA 20105, USA</p>
        <p>
          Email:{" "}
          <a href="mailto:bkdasa@gmail.com" class="text-brand-lotus font-semibold hover:underline">bkdasa@gmail.com</a>
        </p>
      </div>
    </section>

  </div>

</Base>
