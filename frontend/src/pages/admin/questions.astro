---
import AdminShell from "@layouts/AdminShell.astro";
---

<AdminShell title="Ask Guruji — Questions" activePath="/admin/questions">

  <!-- Controls -->
  <div class="flex flex-col sm:flex-row sm:items-center gap-3 mb-6">
    <div class="flex items-center gap-2">
      <label class="text-xs font-semibold text-brand-slate">Show:</label>
      <select id="q-filter"
              class="text-sm rounded-lg border border-brand-tan bg-white px-3 py-1.5
                     focus:outline-none focus:ring-2 focus:ring-brand-lotus text-brand-navy">
        <option value="all">All questions</option>
        <option value="new">New only</option>
      </select>
    </div>
    <span id="q-count" class="text-xs text-brand-slate font-semibold"></span>
  </div>

  <!-- Loading -->
  <div id="q-loading" class="text-center py-16 text-brand-slate text-sm">Loading…</div>

  <!-- List -->
  <div id="q-list" class="hidden space-y-4"></div>

  <!-- Empty -->
  <div id="q-empty" class="hidden text-center py-16 text-brand-slate text-sm">No questions found.</div>

</AdminShell>

<script>
  type Question = {
    id: number;
    name: string;
    email: string | null;
    whatsapp: string | null;
    location: string | null;
    question: string;
    status: 'new' | 'read';
    submitted_at: string;
    read_at: string | null;
  };

  let allQuestions: Question[] = [];
  let currentFilter = 'all';

  const loading = document.getElementById('q-loading')!;
  const list    = document.getElementById('q-list')!;
  const empty   = document.getElementById('q-empty')!;
  const count   = document.getElementById('q-count')!;
  const filter  = document.getElementById('q-filter') as HTMLSelectElement;

  filter.addEventListener('change', () => {
    currentFilter = filter.value;
    render();
  });

  async function load() {
    try {
      const res = await fetch('/api/admin/questions.php', { credentials: 'include' });
      if (res.status === 401) { location.href = '/admin'; return; }
      allQuestions = await res.json();
      render();
    } catch {
      loading.textContent = 'Failed to load questions.';
    }
  }

  function render() {
    const rows = currentFilter === 'new'
      ? allQuestions.filter(q => q.status === 'new')
      : allQuestions;

    loading.classList.add('hidden');

    const newCount = allQuestions.filter(q => q.status === 'new').length;
    count.textContent = `${allQuestions.length} total · ${newCount} new`;

    if (rows.length === 0) {
      list.classList.add('hidden');
      empty.classList.remove('hidden');
      return;
    }

    empty.classList.add('hidden');
    list.innerHTML = rows.map(q => card(q)).join('');
    list.classList.remove('hidden');

    // Wire up buttons
    list.querySelectorAll('[data-action]').forEach(btn => {
      btn.addEventListener('click', () => {
        const el     = btn as HTMLElement;
        const action = el.dataset.action!;
        const id     = parseInt(el.dataset.id!);
        handleAction(action, id);
      });
    });
  }

  function card(q: Question): string {
    const date    = new Date(q.submitted_at).toLocaleDateString('en-US', {
      month: 'short', day: 'numeric', year: 'numeric',
      hour: '2-digit', minute: '2-digit'
    });
    const contact = [
      q.email    ? `<a href="mailto:${esc(q.email)}" class="underline">${esc(q.email)}</a>` : null,
      q.whatsapp ? `<span>WhatsApp: ${esc(q.whatsapp)}</span>` : null,
    ].filter(Boolean).join(' &nbsp;·&nbsp; ');

    const isNew   = q.status === 'new';
    const badge   = isNew
      ? '<span class="inline-block px-2 py-0.5 rounded-full text-xs font-bold bg-brand-lotus text-white">New</span>'
      : '<span class="inline-block px-2 py-0.5 rounded-full text-xs font-semibold bg-brand-parchment text-brand-slate border border-brand-tan">Read</span>';

    return `
      <div id="q-${q.id}" class="rounded-xl border ${isNew ? 'border-brand-lotus/40 bg-pink-50/30' : 'border-brand-tan bg-white'} p-5">
        <div class="flex flex-wrap items-start justify-between gap-2 mb-3">
          <div>
            <span class="font-semibold text-brand-navy text-base">${esc(q.name)}</span>
            ${q.location ? `<span class="text-brand-slate text-sm ml-2">${esc(q.location)}</span>` : ''}
          </div>
          <div class="flex items-center gap-2 flex-wrap">
            ${badge}
            <span class="text-xs text-brand-slate">${date}</span>
          </div>
        </div>

        ${contact ? `<p class="text-sm text-brand-slate mb-3">${contact}</p>` : ''}

        <p class="text-sm text-brand-navy leading-relaxed whitespace-pre-wrap break-words
                   bg-brand-parchment/60 rounded-lg px-4 py-3 border border-brand-tan/60 mb-4">${esc(q.question)}</p>

        <div class="flex gap-2 flex-wrap">
          ${isNew ? `
          <button data-action="read" data-id="${q.id}"
                  class="text-xs font-semibold px-4 py-1.5 rounded-full border border-brand-slate
                         text-brand-slate hover:bg-brand-slate hover:text-white transition-colors">
            Mark as Read
          </button>` : ''}
          <button data-action="delete" data-id="${q.id}"
                  class="text-xs font-semibold px-4 py-1.5 rounded-full border border-red-300
                         text-red-600 hover:bg-red-600 hover:text-white transition-colors">
            Delete
          </button>
        </div>
      </div>
    `;
  }

  function esc(s: string | null): string {
    if (!s) return '';
    return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  async function handleAction(action: string, id: number) {
    if (action === 'delete' && !confirm('Delete this question?')) return;

    await fetch('/api/admin/questions.php', {
      method: 'POST',
      credentials: 'include',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ action, id }),
    });

    if (action === 'delete') {
      allQuestions = allQuestions.filter(q => q.id !== id);
    } else {
      const q = allQuestions.find(q => q.id === id);
      if (q) { q.status = 'read'; q.read_at = new Date().toISOString(); }
    }
    render();
  }

  load();
</script>
