---
import AdminShell from "@layouts/AdminShell.astro";
---

<AdminShell title="Ask Guruji — Questions" activePath="/admin/questions">

  <!-- Controls -->
  <div class="flex flex-wrap items-center gap-3 mb-6">
    <!-- Status filter tabs -->
    <div class="flex gap-1 bg-brand-parchment border border-brand-tan rounded-full p-1">
      {['all','submitted','accepted','rejected','responded'].map(s => (
        <button class="q-filter-btn px-3 py-1 rounded-full text-xs font-semibold transition-colors
                       text-brand-slate hover:text-brand-navy"
                data-status={s}>
          {s === 'all' ? 'All' : s.charAt(0).toUpperCase() + s.slice(1)}
        </button>
      ))}
    </div>
    <span id="q-count" class="text-xs text-brand-slate font-semibold ml-auto"></span>
  </div>

  <!-- Loading -->
  <div id="q-loading" class="text-center py-16 text-brand-slate text-sm">Loading…</div>

  <!-- Table -->
  <div id="q-table-wrap" class="hidden overflow-x-auto rounded-xl border border-brand-tan">
    <table class="w-full text-sm border-collapse">
      <thead>
        <tr class="bg-brand-parchment text-brand-slate text-xs font-semibold uppercase tracking-wide">
          <th class="px-4 py-2.5 text-left">Name</th>
          <th class="px-4 py-2.5 text-left">Location</th>
          <th class="px-4 py-2.5 text-left">Question</th>
          <th class="px-4 py-2.5 text-left">Status</th>
          <th class="px-4 py-2.5 text-left">Visibility</th>
          <th class="px-4 py-2.5 text-left">Date</th>
          <th class="px-4 py-2.5"></th>
        </tr>
      </thead>
      <tbody id="q-tbody"></tbody>
    </table>
  </div>

  <!-- Empty -->
  <div id="q-empty" class="hidden text-center py-16 text-brand-slate text-sm">No questions found.</div>

</AdminShell>

<script>
  type Question = {
    id: number;
    name: string;
    email: string | null;
    whatsapp: string | null;
    location: string | null;
    question: string;
    status: 'submitted' | 'accepted' | 'rejected' | 'responded';
    visibility: 'public' | 'private';
    response: string | null;
    submitted_at: string;
  };

  const STATUSES    = ['submitted', 'accepted', 'rejected', 'responded'] as const;
  const VISIBILITIES = ['public', 'private'] as const;

  let allQuestions: Question[] = [];
  let currentFilter = 'all';
  let expandedId: number | null = null;

  const loading   = document.getElementById('q-loading')!;
  const tableWrap = document.getElementById('q-table-wrap')!;
  const tbody     = document.getElementById('q-tbody')!;
  const empty     = document.getElementById('q-empty')!;
  const countEl   = document.getElementById('q-count')!;

  // ── Filter tabs ─────────────────────────────────────────────────────────
  document.querySelectorAll('.q-filter-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      currentFilter = (btn as HTMLElement).dataset.status!;
      expandedId = null;
      highlightFilter();
      render();
    });
  });

  function highlightFilter() {
    document.querySelectorAll('.q-filter-btn').forEach(btn => {
      const active = (btn as HTMLElement).dataset.status === currentFilter;
      btn.classList.toggle('bg-white',        active);
      btn.classList.toggle('text-brand-navy', active);
      btn.classList.toggle('shadow-sm',       active);
      btn.classList.toggle('text-brand-slate',!active);
    });
  }

  // ── Load ─────────────────────────────────────────────────────────────────
  async function load() {
    try {
      const res = await fetch('/api/admin/questions.php', { credentials: 'include' });
      if (res.status === 401) { location.href = '/admin'; return; }
      allQuestions = await res.json();
      highlightFilter();
      render();
    } catch {
      loading.textContent = 'Failed to load questions.';
    }
  }

  // ── Render ────────────────────────────────────────────────────────────────
  function render() {
    const rows = currentFilter === 'all'
      ? allQuestions
      : allQuestions.filter(q => q.status === currentFilter);

    loading.classList.add('hidden');

    const submitted = allQuestions.filter(q => q.status === 'submitted').length;
    countEl.textContent = `${allQuestions.length} total · ${submitted} submitted`;

    if (rows.length === 0) {
      tableWrap.classList.add('hidden');
      empty.classList.remove('hidden');
      return;
    }

    empty.classList.add('hidden');
    tableWrap.classList.remove('hidden');

    tbody.innerHTML = rows.map(q => row(q) + editPanel(q)).join('');

    // Wire edit-toggle buttons
    tbody.querySelectorAll('[data-toggle-edit]').forEach(btn => {
      btn.addEventListener('click', () => {
        const id = parseInt((btn as HTMLElement).dataset.toggleEdit!);
        toggleEdit(id);
      });
    });

    // Wire save buttons
    tbody.querySelectorAll('[data-save-id]').forEach(btn => {
      btn.addEventListener('click', () => {
        const id = parseInt((btn as HTMLElement).dataset.saveId!);
        save(id);
      });
    });

    // Wire delete buttons
    tbody.querySelectorAll('[data-delete-id]').forEach(btn => {
      btn.addEventListener('click', () => {
        const id = parseInt((btn as HTMLElement).dataset.deleteId!);
        del(id);
      });
    });

    // Restore expanded row
    if (expandedId !== null) {
      const panel = document.getElementById(`q-panel-${expandedId}`);
      if (panel) panel.classList.remove('hidden');
    }
  }

  function statusBadge(s: string): string {
    const map: Record<string, string> = {
      submitted: 'bg-amber-100 text-amber-800 border-amber-200',
      accepted:  'bg-blue-100 text-blue-800 border-blue-200',
      rejected:  'bg-red-100 text-red-700 border-red-200',
      responded: 'bg-emerald-100 text-emerald-800 border-emerald-200',
    };
    const cls = map[s] ?? 'bg-gray-100 text-gray-600 border-gray-200';
    return `<span class="inline-block px-2 py-0.5 rounded-full text-xs font-semibold border ${cls}">${esc(s)}</span>`;
  }

  function row(q: Question): string {
    const date = new Date(q.submitted_at).toLocaleDateString('en-US', {
      month: 'short', day: 'numeric', year: 'numeric'
    });
    const preview = q.question.length > 60 ? q.question.slice(0, 60) + '…' : q.question;
    const visBadge = q.visibility === 'public'
      ? '<span class="text-xs text-emerald-700 font-semibold">Public</span>'
      : '<span class="text-xs text-brand-slate">Private</span>';

    return `
      <tr id="q-row-${q.id}" class="border-t border-brand-tan/60 hover:bg-brand-parchment/40 transition-colors">
        <td class="px-4 py-3 font-medium text-brand-navy whitespace-nowrap">${esc(q.name)}</td>
        <td class="px-4 py-3 text-brand-slate whitespace-nowrap">${esc(q.location ?? '—')}</td>
        <td class="px-4 py-3 text-brand-slate max-w-xs">${esc(preview)}</td>
        <td class="px-4 py-3 whitespace-nowrap">${statusBadge(q.status)}</td>
        <td class="px-4 py-3 whitespace-nowrap">${visBadge}</td>
        <td class="px-4 py-3 text-brand-slate whitespace-nowrap text-xs">${date}</td>
        <td class="px-4 py-3">
          <button data-toggle-edit="${q.id}" class="btn-edit whitespace-nowrap">Edit</button>
        </td>
      </tr>
    `;
  }

  function editPanel(q: Question): string {
    const contact = [
      q.email    ? `<a href="mailto:${esc(q.email)}" class="underline text-brand-navy">${esc(q.email)}</a>` : null,
      q.whatsapp ? `WhatsApp: ${esc(q.whatsapp)}` : null,
    ].filter(Boolean).join(' &nbsp;·&nbsp; ');

    const statusOpts = STATUSES.map(s =>
      `<option value="${s}" ${q.status === s ? 'selected' : ''}>${s.charAt(0).toUpperCase() + s.slice(1)}</option>`
    ).join('');

    const visOpts = VISIBILITIES.map(v =>
      `<option value="${v}" ${q.visibility === v ? 'selected' : ''}>${v.charAt(0).toUpperCase() + v.slice(1)}</option>`
    ).join('');

    return `
      <tr id="q-panel-${q.id}" class="hidden border-t border-brand-lotus/20 bg-brand-parchment/30">
        <td colspan="7" class="px-6 py-5">

          <!-- Contact -->
          ${contact ? `<p class="text-xs text-brand-slate mb-3">${contact}</p>` : ''}

          <!-- Full question -->
          <div class="mb-4">
            <p class="text-xs font-semibold uppercase tracking-wide text-brand-slate mb-1">Question</p>
            <p class="text-sm text-brand-navy leading-relaxed whitespace-pre-wrap break-words
                      bg-white rounded-lg border border-brand-tan px-4 py-3">${esc(q.question)}</p>
          </div>

          <!-- Edit fields -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
            <div>
              <label class="block text-xs font-semibold uppercase tracking-wide text-brand-slate mb-1">Status</label>
              <select id="q-status-${q.id}"
                      class="w-full text-sm rounded-lg border border-brand-tan bg-white px-3 py-2
                             focus:outline-none focus:ring-2 focus:ring-brand-lotus/40 text-brand-navy">
                ${statusOpts}
              </select>
            </div>
            <div>
              <label class="block text-xs font-semibold uppercase tracking-wide text-brand-slate mb-1">Visibility</label>
              <select id="q-vis-${q.id}"
                      class="w-full text-sm rounded-lg border border-brand-tan bg-white px-3 py-2
                             focus:outline-none focus:ring-2 focus:ring-brand-lotus/40 text-brand-navy">
                ${visOpts}
              </select>
            </div>
          </div>

          <div class="mb-4">
            <label class="block text-xs font-semibold uppercase tracking-wide text-brand-slate mb-1">Response</label>
            <textarea id="q-response-${q.id}" rows="5"
                      class="w-full text-sm rounded-lg border border-brand-tan bg-white px-3 py-2
                             focus:outline-none focus:ring-2 focus:ring-brand-lotus/40 text-brand-navy
                             resize-y leading-relaxed"
                      placeholder="Write Guruji's response here…">${esc(q.response ?? '')}</textarea>
          </div>

          <div id="q-msg-${q.id}" class="hidden text-xs mb-3 px-3 py-2 rounded-lg"></div>

          <div class="flex gap-2">
            <button data-save-id="${q.id}" class="btn-save !text-xs !px-4 !py-1.5">Save</button>
            <button data-delete-id="${q.id}" class="btn-delete">Delete</button>
          </div>
        </td>
      </tr>
    `;
  }

  function toggleEdit(id: number) {
    const panel = document.getElementById(`q-panel-${id}`);
    if (!panel) return;
    const isOpen = !panel.classList.contains('hidden');
    if (isOpen) {
      panel.classList.add('hidden');
      expandedId = null;
    } else {
      // close any other open panel
      tbody.querySelectorAll('[id^="q-panel-"]').forEach(p => p.classList.add('hidden'));
      panel.classList.remove('hidden');
      expandedId = id;
    }
  }

  // ── Save ──────────────────────────────────────────────────────────────────
  async function save(id: number) {
    const statusEl   = document.getElementById(`q-status-${id}`)   as HTMLSelectElement;
    const visEl      = document.getElementById(`q-vis-${id}`)      as HTMLSelectElement;
    const responseEl = document.getElementById(`q-response-${id}`) as HTMLTextAreaElement;
    const msgEl      = document.getElementById(`q-msg-${id}`)!;

    const saveBtn = tbody.querySelector(`[data-save-id="${id}"]`) as HTMLButtonElement;
    saveBtn.disabled = true;
    saveBtn.textContent = 'Saving…';

    try {
      const res = await fetch('/api/admin/questions.php', {
        method: 'PUT',
        credentials: 'include',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          id,
          status:     statusEl.value,
          visibility: visEl.value,
          response:   responseEl.value,
        }),
      });

      const data = await res.json();

      if (res.ok) {
        // Update local state
        const q = allQuestions.find(q => q.id === id);
        if (q) {
          q.status     = statusEl.value as Question['status'];
          q.visibility = visEl.value as Question['visibility'];
          q.response   = responseEl.value || null;
        }
        msgEl.textContent = 'Saved.';
        msgEl.className   = 'text-xs mb-3 px-3 py-2 rounded-lg bg-emerald-50 text-emerald-800 border border-emerald-200';
        msgEl.classList.remove('hidden');
        setTimeout(() => msgEl.classList.add('hidden'), 2000);
        render(); // refresh badges in table row
      } else {
        msgEl.textContent = data.message || 'Save failed.';
        msgEl.className   = 'text-xs mb-3 px-3 py-2 rounded-lg bg-red-50 text-red-700 border border-red-200';
        msgEl.classList.remove('hidden');
      }
    } catch {
      msgEl.textContent = 'Network error.';
      msgEl.className   = 'text-xs mb-3 px-3 py-2 rounded-lg bg-red-50 text-red-700 border border-red-200';
      msgEl.classList.remove('hidden');
    }

    saveBtn.disabled = false;
    saveBtn.textContent = 'Save';
  }

  // ── Delete ────────────────────────────────────────────────────────────────
  async function del(id: number) {
    if (!confirm('Delete this question permanently?')) return;

    await fetch('/api/admin/questions.php', {
      method: 'DELETE',
      credentials: 'include',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id }),
    });

    allQuestions = allQuestions.filter(q => q.id !== id);
    expandedId = null;
    render();
  }

  function esc(s: string | null): string {
    if (!s) return '';
    return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  load();
</script>
