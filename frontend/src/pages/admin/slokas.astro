  /* ── Save ────────────────────────────────────────────────────────────────── */
  $('sl-editor-save-btn').addEventListener('click', async () => {
    const scrIdVal = ($<HTMLSelectElement>('sl-ed-scripture-id')).value;
    const payload: Record<string, any> = {
      category_code:   ($<HTMLSelectElement>('sl-ed-category')).value,
      slokamrtam_ref:  ($<HTMLInputElement>('sl-ed-ref')).value.trim()           || null,
      title:           ($<HTMLInputElement>('sl-ed-title')).value.trim()         || null,
      search_title:    ($<HTMLInputElement>('sl-ed-search-title')).value.trim()  || null,
      sloka_text:      ($<HTMLTextAreaElement>('sl-ed-text')).value.trim(),
      scripture_id:    scrIdVal ? parseInt(scrIdVal, 10) : null,
      scripture_ref:   ($<HTMLInputElement>('sl-ed-scr-ref')).value.trim()       || null,
      word_by_word:    ($<HTMLTextAreaElement>('sl-ed-wbw')).value.trim()         || null,
      translation:     ($<HTMLTextAreaElement>('sl-ed-translation')).value.trim() || null,
      commentary:      ($<HTMLTextAreaElement>('sl-ed-commentary')).value.trim()  || null,
    };

    if (!payload.sloka_text)    { setStatus('Sloka text is required.', true); return; }
    if (!payload.category_code) { setStatus('Category is required.',   true); return; }

    const saveBtn = $<HTMLButtonElement>('sl-editor-save-btn');
    saveBtn.disabled = true;

    try {
      let finalAudioPath: string | null = activeSloka?.audio_file_path ?? null;

      if (removeAudio) {
        // Archive old file (best-effort) then clear path
        if (finalAudioPath) await archiveSlokaAudio(finalAudioPath);
        finalAudioPath = null;
      }

      if (isNew) {
        // ── New sloka ─────────────────────────────────────────────────────────
        // 1. Save without audio first to get the id
        setStatus('Saving…');
        payload.audio_file_path = null;
        const res = await apiFetch('/api/admin/slokas.php', { method: 'POST', body: JSON.stringify(payload) });
        const newId: number = res.id;

        // 2. Upload audio if a file was selected
        if (pendingAudio) {
          setStatus('Uploading audio…');
          const st = payload.search_title || payload.sloka_text.split('\n')[0] || '';
          finalAudioPath = await uploadSlokaAudio(newId, st, pendingAudio);
          // 3. Patch the sloka with the audio path
          await apiFetch('/api/admin/slokas.php', {
            method: 'PUT',
            body: JSON.stringify({ ...payload, id: newId, audio_file_path: finalAudioPath }),
          });
        }

        setStatus('Saved ✓');
        const cat = ($<HTMLSelectElement>('sl-cat-filter')).value;
        const scr = ($<HTMLSelectElement>('sl-scr-filter')).value;
        const q   = ($<HTMLInputElement>('sl-search')).value.trim();
        await loadSlokas(q, cat, scr);
        const newItem = slokas.find(s => s.id === newId);
        if (newItem) openEditor(newItem);

      } else {
        // ── Existing sloka ────────────────────────────────────────────────────
        // Upload audio first (if chosen) so path goes into the save call
        if (pendingAudio && activeSloka) {
          setStatus('Uploading audio…');
          const st = payload.search_title || activeSloka.search_title || payload.sloka_text.split('\n')[0] || '';
          finalAudioPath = await uploadSlokaAudio(activeSloka.id, st, pendingAudio);
        }

        payload.audio_file_path = finalAudioPath;
        payload.id = activeSloka!.id;
        setStatus('Saving…');
        await apiFetch('/api/admin/slokas.php', { method: 'PUT', body: JSON.stringify(payload) });
        setStatus('Saved ✓');

        if (activeSloka) {
          Object.assign(activeSloka, payload);
          setAudioUI(finalAudioPath);
          $('sl-ed-heading').textContent = payload.title || payload.search_title || '—';
          const idx = slokas.findIndex(s => s.id === activeSloka!.id);
          if (idx >= 0) { Object.assign(slokas[idx], payload); renderSlokaList(); highlightRow(activeSloka.id); }
        }
      }

      await loadCategories();
    } catch (e: any) {
      setStatus(e.message, true);
    } finally {
      saveBtn.disabled = false;
    }
  });

  /* ── Delete ──────────────────────────────────────────────────────────────── */
  $('sl-editor-delete-btn').addEventListener('click', async () => {
    if (!activeSloka) return;
    if (!confirm(`Delete Sloka #${activeSloka.id}? This cannot be undone.`)) return;
    try {
      await apiFetch('/api/admin/slokas.php', {
        method: 'DELETE', body: JSON.stringify({ id: activeSloka.id }),
      });
      $('sl-editor-card').classList.add('hidden');
      $('sl-editor-empty').classList.remove('hidden');
      slokas = slokas.filter(s => s.id !== activeSloka!.id);
      activeSloka = null;
      renderSlokaList();
      await loadCategories();
    } catch (e: any) { setStatus(e.message, true); }
  });

  function setStatus(msg: string, isError = false) {
    const el = $('sl-editor-status');
    el.textContent = msg;
    el.classList.toggle('text-red-600',    isError);
    el.classList.toggle('text-brand-slate', !isError);
    if (!isError) setTimeout(() => { if (el.textContent === msg) el.textContent = ''; }, 3000);
  }

  /* ── Init ────────────────────────────────────────────────────────────────── */
  Promise.all([loadCategories(), loadScriptures(), loadSlokas('', '', '')]);

})();
</script>
