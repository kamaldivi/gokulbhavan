  function populateScrDropdowns() {
    const scrFilter = $<HTMLSelectElement>('sl-scr-filter');
    const prevF = scrFilter.value;
    scrFilter.innerHTML = '<option value="">— Scripture —</option>' +
      scrAll.map(s =>
        `<option value="${s.id}">${escHtml(s.name)}${s.short_title ? ' (' + escHtml(s.short_title) + ')' : ''}</option>`
      ).join('');
    scrFilter.value = prevF;

    const edScr = $<HTMLSelectElement>('sl-ed-scripture-id');
    const prevE = edScr.value;
    edScr.innerHTML = '<option value="">— None —</option>' +
      scrAll.map(s =>
        `<option value="${s.id}">${escHtml(s.name)}${s.short_title ? ' (' + escHtml(s.short_title) + ')' : ''}</option>`
      ).join('');
    edScr.value = prevE;
  }

  function renderScriptureTable(filter = '') {
    const filtered = filter
      ? scrAll.filter(s =>
          s.name.toLowerCase().includes(filter) ||
          (s.short_title ?? '').toLowerCase().includes(filter)
        )
      : scrAll;

    $('scr-count').textContent = filter
      ? `${filtered.length} of ${scrAll.length} scriptures`
      : `${scrAll.length} scriptures`;

    const tbody = $('scr-tbody');
    tbody.innerHTML = '';
    filtered.forEach(s => tbody.appendChild(makeScrRow(s)));
    $('scr-table').classList.remove('hidden');
  }

