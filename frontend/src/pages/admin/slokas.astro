     SLOKAS TAB — Mutually exclusive filters
  ═══════════════════════════════════════════════════════════════════════════ */

  $('sl-search').addEventListener('input', () => {
    // Clear other filters when typing in search
    ($<HTMLSelectElement>('sl-cat-filter')).value = '';
    ($<HTMLSelectElement>('sl-scr-filter')).value = '';
    if (searchTimer) clearTimeout(searchTimer);
    const q = ($<HTMLInputElement>('sl-search')).value.trim();
    searchTimer = setTimeout(() => {
      if (q.length >= 2) loadSlokas(q, '', '');
      else setListState('hint');
    }, 350);
  });

  $('sl-cat-filter').addEventListener('change', () => {
    ($<HTMLInputElement>('sl-search')).value       = '';
    ($<HTMLSelectElement>('sl-scr-filter')).value  = '';
    const cat = ($<HTMLSelectElement>('sl-cat-filter')).value;
    if (cat) loadSlokas('', cat, '');
    else setListState('hint');
  });

  $('sl-scr-filter').addEventListener('change', () => {
    ($<HTMLInputElement>('sl-search')).value       = '';
    ($<HTMLSelectElement>('sl-cat-filter')).value  = '';
    const scr = ($<HTMLSelectElement>('sl-scr-filter')).value;
    if (scr) loadSlokas('', '', scr);
    else setListState('hint');
  });

  async function loadSlokas(search: string, cat: string, scr: string) {
    setListState('loading');
    try {
      const qs = new URLSearchParams();
      if (search) qs.set('search', search);
      if (cat)    qs.set('category', cat);
      if (scr)    qs.set('scripture_id', scr);
      slokas = await apiFetch('/api/admin/slokas.php?' + qs.toString());
      renderSlokaList();
    } catch {
      setListState('empty');
    }
  }

  function setListState(state: 'hint'|'loading'|'empty'|'list') {
    $('sl-list-hint').classList.toggle(   'hidden', state !== 'hint');
    $('sl-list-loading').classList.toggle('hidden', state !== 'loading');
    $('sl-list-empty').classList.toggle(  'hidden', state !== 'empty');
    $('sl-list-wrap').classList.toggle(   'hidden', state !== 'list');
  }

  function renderSlokaList() {
    if (slokas.length === 0) { setListState('empty'); return; }
    setListState('list');
    $('sl-list-count').textContent = `${slokas.length} sloka${slokas.length !== 1 ? 's' : ''}`;
    const tbody = $('sl-list-tbody');
    tbody.innerHTML = '';
    slokas.forEach(s => {
      const tr = document.createElement('tr');
      tr.className = 'hover:bg-brand-parchment/40 cursor-pointer transition-colors';
      tr.dataset.id = String(s.id);
      const label = s.search_title || s.title || s.sloka_text?.split('\n')[0] || '—';
      tr.innerHTML = `
        <td class="px-3 py-2.5">
          <div class="flex items-baseline gap-1.5">
            <span class="text-xs font-mono text-brand-slate shrink-0">#${s.id}</span>
            <span class="text-sm text-brand-navy font-semibold leading-snug">${escHtml(label.substring(0, 72))}</span>
            ${s.audio_file_path ? '<span class="shrink-0 text-xs text-green-600 font-bold ml-1">♫</span>' : ''}
          </div>
          <div class="flex items-center gap-2 mt-0.5 pl-5">
            <span class="text-xs text-brand-slate font-medium">${escHtml(s.category_name)}</span>
            ${s.scripture_name
              ? `<span class="text-xs text-brand-slate"> · ${escHtml(s.scripture_name)}</span>`
              : ''}
          </div>
        </td>
      `;
      tr.addEventListener('click', () => openEditor(s));
      tbody.appendChild(tr);
    });
    if (activeSloka) highlightRow(activeSloka.id);
  }

  function highlightRow(id: number) {
    $('sl-list-tbody').querySelectorAll('tr').forEach(tr =>
      tr.classList.toggle('bg-brand-parchment', (tr as HTMLTableRowElement).dataset.id === String(id))
    );
  }

