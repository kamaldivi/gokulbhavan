     SLOKAS TAB — Editor
  ═══════════════════════════════════════════════════════════════════════════ */

  function openEditor(s: Sloka) {
    isNew       = false;
    activeSloka = s;
    highlightRow(s.id);
    $('sl-editor-empty').classList.add('hidden');
    $('sl-editor-card').classList.remove('hidden');

    $('sl-ed-id-label').textContent = `Sloka #${s.id}`;
    $('sl-ed-heading').textContent  = s.title || s.search_title || '—';

    ($<HTMLSelectElement>('sl-ed-category')).value     = s.category_code;
    ($<HTMLInputElement>('sl-ed-ref')).value            = s.slokamrtam_ref    ?? '';
    ($<HTMLInputElement>('sl-ed-title')).value          = s.title             ?? '';
    ($<HTMLInputElement>('sl-ed-search-title')).value   = s.search_title      ?? '';
    ($<HTMLTextAreaElement>('sl-ed-text')).value        = s.sloka_text        ?? '';
    ($<HTMLSelectElement>('sl-ed-scripture-id')).value  = s.scripture_id != null ? String(s.scripture_id) : '';
    ($<HTMLInputElement>('sl-ed-scr-ref')).value        = s.scripture_ref     ?? '';
    setAudioUI(s.audio_file_path);
    ($<HTMLTextAreaElement>('sl-ed-wbw')).value          = s.word_by_word  ?? '';
    ($<HTMLTextAreaElement>('sl-ed-translation')).value = s.translation   ?? '';
    ($<HTMLTextAreaElement>('sl-ed-commentary')).value  = s.commentary    ?? '';

    $('sl-editor-status').textContent = '';
    $('sl-editor-delete-btn').classList.remove('hidden');
  }

