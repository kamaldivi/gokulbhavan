---
import AdminShell from "@layouts/AdminShell.astro";
---

<AdminShell title="Programs" activePath="/admin/programs">

  <!-- Top bar -->
  <div class="flex items-center justify-between mb-5">
    <div class="flex items-center gap-2 flex-wrap" id="prog-filter-tabs">
      {['all','active','upcoming','completed','one-off'].map(t => (
        <button data-filter={t}
                class={`prog-tab text-xs font-bold uppercase tracking-wide px-3 py-1.5 rounded-full border transition-colors
                        ${t === 'all'
                          ? 'bg-brand-navy text-white border-brand-navy'
                          : 'bg-white text-brand-slate border-brand-tan hover:border-brand-navy hover:text-brand-navy'}`}>
          {t === 'all' ? 'All' : t.charAt(0).toUpperCase() + t.slice(1)}
        </button>
      ))}
    </div>
    <button id="prog-new-btn" class="btn-new inline-flex items-center gap-1.5 shrink-0">
      <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/></svg>
      New Program
    </button>
  </div>

  <!-- Banner -->
  <div id="prog-banner" class="hidden mb-4 rounded-lg px-4 py-3 text-sm text-center font-semibold"></div>

  <!-- Loading -->
  <div id="prog-loading" class="text-center py-16 text-brand-slate text-sm">Loading…</div>

  <!-- List -->
  <div id="prog-list" class="hidden space-y-2"></div>

  <!-- Empty -->
  <div id="prog-empty" class="hidden text-center py-16 text-brand-slate text-sm">
    No programs found.
  </div>

  <!-- ── Slide-in panel ──────────────────────────────────────── -->
  <div id="prog-panel"
       class="hidden fixed inset-y-0 right-0 z-50 w-full max-w-lg bg-white shadow-2xl flex flex-col">

    <div class="admin-panel-header">
      <h3 id="prog-panel-title" class="font-display font-bold text-brand-navy text-lg">New Program</h3>
      <button id="prog-panel-close" class="text-brand-slate hover:text-brand-navy transition-colors" aria-label="Close">
        <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg>
      </button>
    </div>

    <form id="prog-form" class="admin-panel-body">
      <input type="hidden" id="prog-edit-id" value="" />

      <!-- Title -->
      <div>
        <label class="block text-xs font-bold uppercase tracking-wider text-brand-slate mb-1.5" for="prog-title">
          Title <span class="text-brand-lotus">*</span>
        </label>
        <input id="prog-title" type="text" required
               class="w-full px-3 py-2 text-sm rounded-lg border border-brand-tan focus:outline-none focus:ring-2 focus:ring-brand-lotus" />
      </div>

      <!-- Description -->
      <div>
        <label class="block text-xs font-bold uppercase tracking-wider text-brand-slate mb-1.5" for="prog-desc">
          Description <span class="text-brand-slate/50 normal-case font-normal">(optional)</span>
        </label>
        <textarea id="prog-desc" rows="3"
                  class="w-full px-3 py-2 text-sm rounded-lg border border-brand-tan focus:outline-none focus:ring-2 focus:ring-brand-lotus resize-y"></textarea>
      </div>

      <!-- Teacher + Language -->
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-brand-slate mb-1.5" for="prog-teacher">Teacher</label>
          <input id="prog-teacher" type="text" placeholder="H.G. Dasa"
                 class="w-full px-3 py-2 text-sm rounded-lg border border-brand-tan focus:outline-none focus:ring-2 focus:ring-brand-lotus" />
        </div>
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-brand-slate mb-1.5" for="prog-language">Language</label>
          <select id="prog-language"
                  class="w-full px-3 py-2 text-sm rounded-lg border border-brand-tan focus:outline-none focus:ring-2 focus:ring-brand-lotus bg-white">
            <option value="">— select —</option>
            <option value="English">English</option>
            <option value="Tamil">Tamil</option>
            <option value="Hindi">Hindi</option>
            <option value="Sanskrit">Sanskrit</option>
          </select>
        </div>
      </div>

      <!-- Program type toggle -->
      <div>
        <p class="text-xs font-bold uppercase tracking-wider text-brand-slate mb-2">Program Type</p>
        <div class="flex rounded-lg border border-brand-tan overflow-hidden text-xs font-bold">
          <button type="button" id="type-recurring"
                  class="flex-1 py-2 bg-brand-navy text-white transition-colors">Recurring</button>
          <button type="button" id="type-oneoff"
                  class="flex-1 py-2 bg-white text-brand-slate hover:bg-brand-parchment transition-colors">One-off Event</button>
        </div>
      </div>

      <!-- Recurring fields -->
      <div id="recurring-fields" class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-brand-slate mb-1.5" for="prog-day">Day of Week</label>
            <select id="prog-day"
                    class="w-full px-3 py-2 text-sm rounded-lg border border-brand-tan focus:outline-none focus:ring-2 focus:ring-brand-lotus bg-white">
              <option value="">— select —</option>
              {['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'].map(d => (
                <option value={d}>{d}</option>
              ))}
            </select>
          </div>
          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-brand-slate mb-1.5" for="prog-time">Time (EST)</label>
            <input id="prog-time" type="time"
                   class="w-full px-3 py-2 text-sm rounded-lg border border-brand-tan focus:outline-none focus:ring-2 focus:ring-brand-lotus" />
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-brand-slate mb-1.5" for="prog-start">Start Date</label>
            <input id="prog-start" type="date"
                   class="w-full px-3 py-2 text-sm rounded-lg border border-brand-tan focus:outline-none focus:ring-2 focus:ring-brand-lotus" />
          </div>
          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-brand-slate mb-1.5" for="prog-end">End Date</label>
            <input id="prog-end" type="date"
                   class="w-full px-3 py-2 text-sm rounded-lg border border-brand-tan focus:outline-none focus:ring-2 focus:ring-brand-lotus" />
          </div>
        </div>
      </div>

      <!-- One-off fields -->
      <div id="oneoff-fields" class="hidden space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-brand-slate mb-1.5" for="prog-event-date">
              Event Date <span class="text-brand-lotus">*</span>
            </label>
            <input id="prog-event-date" type="date"
                   class="w-full px-3 py-2 text-sm rounded-lg border border-brand-tan focus:outline-none focus:ring-2 focus:ring-brand-lotus" />
          </div>
          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-brand-slate mb-1.5" for="prog-event-time">Time (EST)</label>
            <input id="prog-event-time" type="time"
                   class="w-full px-3 py-2 text-sm rounded-lg border border-brand-tan focus:outline-none focus:ring-2 focus:ring-brand-lotus" />
          </div>
        </div>
      </div>

      <!-- Platform + Duration -->
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-brand-slate mb-1.5" for="prog-platform">Platform</label>
          <select id="prog-platform"
                  class="w-full px-3 py-2 text-sm rounded-lg border border-brand-tan focus:outline-none focus:ring-2 focus:ring-brand-lotus bg-white">
            <option value="">— select —</option>
            <option value="Zoom">Zoom</option>
            <option value="YouTube">YouTube</option>
            <option value="Both">Both</option>
            <option value="In-Person">In-Person</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-brand-slate mb-1.5" for="prog-duration">Duration (min)</label>
          <input id="prog-duration" type="number" min="5" step="5"
                 class="w-full px-3 py-2 text-sm rounded-lg border border-brand-tan focus:outline-none focus:ring-2 focus:ring-brand-lotus" />
        </div>
      </div>

      <!-- Zoom URL -->
      <div>
        <label class="block text-xs font-bold uppercase tracking-wider text-brand-slate mb-1.5" for="prog-zoom">Zoom URL</label>
        <input id="prog-zoom" type="url" placeholder="https://zoom.us/j/…"
               class="w-full px-3 py-2 text-sm rounded-lg border border-brand-tan focus:outline-none focus:ring-2 focus:ring-brand-lotus" />
      </div>

      <!-- YouTube Live URL -->
      <div>
        <label class="block text-xs font-bold uppercase tracking-wider text-brand-slate mb-1.5" for="prog-yt">YouTube Live URL</label>
        <input id="prog-yt" type="url" placeholder="https://youtube.com/live/…"
               class="w-full px-3 py-2 text-sm rounded-lg border border-brand-tan focus:outline-none focus:ring-2 focus:ring-brand-lotus" />
      </div>

      <!-- Video Playlist -->
      <div>
        <label class="block text-xs font-bold uppercase tracking-wider text-brand-slate mb-1.5" for="prog-playlist">
          Video Playlist <span class="text-brand-slate/50 normal-case font-normal">(optional)</span>
        </label>
        <select id="prog-playlist"
                class="w-full px-3 py-2 text-sm rounded-lg border border-brand-tan focus:outline-none focus:ring-2 focus:ring-brand-lotus bg-white">
          <option value="">— none —</option>
        </select>
      </div>

      <!-- Order -->
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-brand-slate mb-1.5" for="prog-order">Order #</label>
          <input id="prog-order" type="number" min="0" value="0"
                 class="w-full px-3 py-2 text-sm rounded-lg border border-brand-tan focus:outline-none focus:ring-2 focus:ring-brand-lotus" />
        </div>
      </div>

    </form>

    <div class="admin-panel-footer">
      <span id="prog-saving" class="hidden text-xs text-brand-slate mr-auto">Saving…</span>
      <button id="prog-save-btn" class="btn-save">Save</button>
    </div>
  </div>

  <!-- Backdrop -->
  <div id="prog-backdrop" class="hidden fixed inset-0 z-40 bg-black/30 backdrop-blur-sm"></div>

</AdminShell>

<script>
  type Prog = {
    id: number;
    title: string;
    description: string | null;
    teacher: string | null;
    language: string | null;
    day_of_week: string | null;
    time_est: string | null;
    event_date: string | null;
    event_time: string | null;
    zoom_url: string | null;
    youtube_live_url: string | null;
    video_playlist: string | null;
    platform: string | null;
    duration_min: number | null;
    site_id: string | null;
    start_date: string | null;
    end_date: string | null;
    order_num: number;
    status: 'active' | 'upcoming' | 'completed' | 'one-off';
  };

  const apiBase = (import.meta as any).env?.VITE_API_BASE_URL ?? '';
  let progs: Prog[] = [];
  let activeFilter = 'all';
  let isOneOff = false;

  const loadingEl  = document.getElementById('prog-loading')!;
  const listEl     = document.getElementById('prog-list')!;
  const emptyEl    = document.getElementById('prog-empty')!;
  const bannerEl   = document.getElementById('prog-banner')!;
  const panel      = document.getElementById('prog-panel')!;
  const backdrop   = document.getElementById('prog-backdrop')!;
  const panelTitle = document.getElementById('prog-panel-title')!;
  const editIdEl   = document.getElementById('prog-edit-id') as HTMLInputElement;

  // Form fields
  const titleEl    = document.getElementById('prog-title')      as HTMLInputElement;
  const descEl     = document.getElementById('prog-desc')       as HTMLTextAreaElement;
  const teacherEl  = document.getElementById('prog-teacher')    as HTMLInputElement;
  const langEl     = document.getElementById('prog-language')   as HTMLSelectElement;
  const dayEl      = document.getElementById('prog-day')        as HTMLSelectElement;
  const timeEl     = document.getElementById('prog-time')       as HTMLInputElement;
  const startEl    = document.getElementById('prog-start')      as HTMLInputElement;
  const endEl      = document.getElementById('prog-end')        as HTMLInputElement;
  const eventDateEl= document.getElementById('prog-event-date') as HTMLInputElement;
  const eventTimeEl= document.getElementById('prog-event-time') as HTMLInputElement;
  const platformEl = document.getElementById('prog-platform')   as HTMLSelectElement;
  const durationEl = document.getElementById('prog-duration')   as HTMLInputElement;
  const zoomEl     = document.getElementById('prog-zoom')       as HTMLInputElement;
  const ytEl       = document.getElementById('prog-yt')         as HTMLInputElement;
  const playlistEl = document.getElementById('prog-playlist')   as HTMLSelectElement;
  const orderEl    = document.getElementById('prog-order')      as HTMLInputElement;

  const recurringFields = document.getElementById('recurring-fields')!;
  const oneoffFields    = document.getElementById('oneoff-fields')!;
  const typeRecurring   = document.getElementById('type-recurring')!;
  const typeOneoff      = document.getElementById('type-oneoff')!;

  // ── Status config ─────────────────────────────────────────────
  const STATUS: Record<string, { label: string; cls: string }> = {
    active:    { label: 'Active',    cls: 'bg-green-100 text-green-700' },
    upcoming:  { label: 'Upcoming',  cls: 'bg-blue-100 text-blue-700' },
    completed: { label: 'Completed', cls: 'bg-brand-tan text-brand-slate/60' },
    'one-off': { label: 'One-off',   cls: 'bg-amber-100 text-amber-700' },
  };

  // ── Load ──────────────────────────────────────────────────────
  async function load() {
    const res = await fetch(`${apiBase}/api/admin/programs.php`);
    if (!res.ok) { loadingEl.textContent = 'Failed to load.'; return; }
    progs = await res.json();
    loadingEl.classList.add('hidden');
    render();
  }

  // ── Render ────────────────────────────────────────────────────
  function render() {
    const filtered = activeFilter === 'all'
      ? progs
      : progs.filter(p => p.status === activeFilter);

    listEl.innerHTML = '';
    if (filtered.length === 0) {
      emptyEl.classList.remove('hidden');
      listEl.classList.add('hidden');
      return;
    }
    emptyEl.classList.add('hidden');
    listEl.classList.remove('hidden');

    filtered.forEach(p => {
      const st   = STATUS[p.status] ?? STATUS['active'];
      const when = p.status === 'one-off' && p.event_date
        ? p.event_date
        : p.day_of_week
          ? `${p.day_of_week}${p.time_est ? ' · ' + p.time_est : ''}`
          : (p.start_date ?? '');

      const card = document.createElement('div');
      card.className = `rounded-xl border border-brand-tan bg-white px-5 py-4 flex items-center justify-between gap-4`;
      card.innerHTML = `
        <div class="min-w-0 flex-1">
          <div class="flex items-center gap-2 flex-wrap mb-0.5">
            <h3 class="font-semibold text-brand-navy text-sm">${esc(p.title)}</h3>
            <span class="text-[10px] font-bold uppercase tracking-wide px-2 py-0.5 rounded-full ${st.cls}">
              ${st.label}
            </span>
            ${p.language ? `<span class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-brand-parchment text-brand-slate">${esc(p.language)}</span>` : ''}
          </div>
          <p class="text-xs text-brand-slate/70">
            ${when ? esc(when) : ''}${p.teacher ? ` · ${esc(p.teacher)}` : ''}
          </p>
        </div>
        <div class="flex items-center gap-2 shrink-0">
          <button class="prog-copy-btn text-xs font-semibold text-brand-slate border border-brand-tan hover:border-brand-navy hover:text-brand-navy px-3 py-1.5 rounded-md transition-colors inline-flex items-center gap-1"
                  data-id="${p.id}" title="Copy WhatsApp join link">
            <svg class="w-3 h-3 fill-current" viewBox="0 0 24 24"><path d="M16 1H4a2 2 0 0 0-2 2v14h2V3h12zm3 4H8a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h11a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2zm0 16H8V7h11z"/></svg>
            Copy Link
          </button>
          <button class="prog-edit-btn btn-edit" data-id="${p.id}">Edit</button>
          <button class="prog-delete-btn btn-delete" data-id="${p.id}">Delete</button>
        </div>`;

      card.querySelector<HTMLButtonElement>('.prog-copy-btn')!
        .addEventListener('click', (e) => copyJoinLink(p.id, e.currentTarget as HTMLButtonElement));
      card.querySelector<HTMLButtonElement>('.prog-edit-btn')!
        .addEventListener('click', () => openEdit(p));
      card.querySelector<HTMLButtonElement>('.prog-delete-btn')!
        .addEventListener('click', () => deleteProg(p.id));

      listEl.appendChild(card);
    });
  }

  // ── Filter tabs ───────────────────────────────────────────────
  document.querySelectorAll<HTMLButtonElement>('.prog-tab').forEach(btn => {
    btn.addEventListener('click', () => {
      activeFilter = btn.dataset.filter!;
      document.querySelectorAll('.prog-tab').forEach(b => {
        const active = (b as HTMLElement).dataset.filter === activeFilter;
        b.className = `prog-tab text-xs font-bold uppercase tracking-wide px-3 py-1.5 rounded-full border transition-colors
          ${active
            ? 'bg-brand-navy text-white border-brand-navy'
            : 'bg-white text-brand-slate border-brand-tan hover:border-brand-navy hover:text-brand-navy'}`;
      });
      render();
    });
  });

  // ── Type toggle ───────────────────────────────────────────────
  function setType(oneoff: boolean) {
    isOneOff = oneoff;
    recurringFields.classList.toggle('hidden', oneoff);
    oneoffFields.classList.toggle('hidden', !oneoff);
    typeRecurring.className = `flex-1 py-2 transition-colors ${!oneoff ? 'bg-brand-navy text-white' : 'bg-white text-brand-slate hover:bg-brand-parchment'}`;
    typeOneoff.className    = `flex-1 py-2 transition-colors ${oneoff  ? 'bg-brand-navy text-white' : 'bg-white text-brand-slate hover:bg-brand-parchment'}`;
  }
  typeRecurring.addEventListener('click', () => setType(false));
  typeOneoff.addEventListener('click',    () => setType(true));

  // ── Playlist dropdown ─────────────────────────────────────────
  let playlistsLoaded = false;

  async function loadPlaylists(selectedName: string | null) {
    if (playlistsLoaded) {
      playlistEl.value = selectedName ?? '';
      return;
    }
    try {
      const res = await fetch(`${apiBase}/api/admin/video-library.php?playlists=1`, { credentials: 'same-origin' });
      if (!res.ok) throw new Error();
      const rows: { playlist_id: string; playlist_name: string; category_name: string }[] = await res.json();

      // Group by category for <optgroup>
      const groups: Record<string, string[]> = {};
      rows.forEach(r => {
        if (!groups[r.category_name]) groups[r.category_name] = [];
        groups[r.category_name].push(r.playlist_name);
      });

      playlistEl.innerHTML = '<option value="">— none —</option>';
      Object.entries(groups).forEach(([cat, names]) => {
        const og = document.createElement('optgroup');
        og.label = cat;
        names.forEach(name => {
          const opt = document.createElement('option');
          opt.value = name;
          opt.textContent = name;
          og.appendChild(opt);
        });
        playlistEl.appendChild(og);
      });

      playlistsLoaded = true;
    } catch {
      // Leave the select with just "— none —" if fetch fails
    }
    playlistEl.value = selectedName ?? '';
  }

  // ── Panel open/close ──────────────────────────────────────────
  function openPanel() {
    panel.classList.remove('hidden');
    backdrop.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }
  function closePanel() {
    panel.classList.add('hidden');
    backdrop.classList.add('hidden');
    document.body.style.overflow = '';
  }

  function openNew() {
    panelTitle.textContent = 'New Program';
    editIdEl.value    = '';
    titleEl.value     = '';
    descEl.value      = '';
    teacherEl.value   = '';
    langEl.value      = '';
    dayEl.value       = '';
    timeEl.value      = '';
    startEl.value     = '';
    endEl.value       = '';
    eventDateEl.value = '';
    eventTimeEl.value = '';
    platformEl.value  = '';
    durationEl.value  = '';
    zoomEl.value      = '';
    ytEl.value        = '';
    orderEl.value     = '0';
    setType(false);
    openPanel();
    loadPlaylists(null);
  }

  function openEdit(p: Prog) {
    panelTitle.textContent = 'Edit Program';
    editIdEl.value    = String(p.id);
    titleEl.value     = p.title;
    descEl.value      = p.description    ?? '';
    teacherEl.value   = p.teacher        ?? '';
    langEl.value      = p.language       ?? '';
    dayEl.value       = p.day_of_week    ?? '';
    timeEl.value      = p.time_est       ?? '';
    startEl.value     = p.start_date     ?? '';
    endEl.value       = p.end_date       ?? '';
    eventDateEl.value = p.event_date     ?? '';
    eventTimeEl.value = p.event_time     ?? '';
    platformEl.value  = p.platform       ?? '';
    durationEl.value  = p.duration_min != null ? String(p.duration_min) : '';
    zoomEl.value      = p.zoom_url           ?? '';
    ytEl.value        = p.youtube_live_url  ?? '';
    orderEl.value     = String(p.order_num ?? 0);
    setType(p.status === 'one-off');
    openPanel();
    loadPlaylists(p.video_playlist ?? null);
  }

  // ── Save ──────────────────────────────────────────────────────
  document.getElementById('prog-save-btn')!.addEventListener('click', async () => {
    const id     = editIdEl.value;
    const saving = document.getElementById('prog-saving')!;
    saving.classList.remove('hidden');

    if (!titleEl.value.trim()) {
      saving.classList.add('hidden');
      titleEl.focus();
      return;
    }

    const payload: Record<string, any> = {
      title:       titleEl.value.trim(),
      description: descEl.value.trim()     || null,
      teacher:     teacherEl.value.trim()  || null,
      language:    langEl.value            || null,
      platform:    platformEl.value        || null,
      duration_min: durationEl.value       ? parseInt(durationEl.value) : null,
      zoom_url:         zoomEl.value.trim()     || null,
      youtube_live_url: ytEl.value.trim()      || null,
      video_playlist:   playlistEl.value.trim() || null,
      order_num:   parseInt(orderEl.value) || 0,
    };

    if (isOneOff) {
      const ed = eventDateEl.value || null;
      payload.event_date  = ed;
      payload.event_time  = eventTimeEl.value || null;
      payload.start_date  = ed;
      payload.end_date    = ed;
      payload.day_of_week = null;
      payload.time_est    = null;
    } else {
      payload.day_of_week = dayEl.value       || null;
      payload.time_est    = timeEl.value      || null;
      payload.start_date  = startEl.value     || null;
      payload.end_date    = endEl.value       || null;
      payload.event_date  = null;
      payload.event_time  = null;
    }

    const url    = id ? `${apiBase}/api/admin/programs.php?id=${id}` : `${apiBase}/api/admin/programs.php`;
    const method = id ? 'PUT' : 'POST';
    const res    = await fetch(url, {
      method,
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    });
    saving.classList.add('hidden');

    if (res.ok) {
      closePanel();
      showBanner('Program saved.', 'green');
      await load();
    } else {
      showBanner('Save failed. Please try again.', 'red');
    }
  });

  // ── Delete ────────────────────────────────────────────────────
  async function deleteProg(id: number) {
    if (!confirm('Delete this program?')) return;
    const res = await fetch(`${apiBase}/api/admin/programs.php?id=${id}`, { method: 'DELETE' });
    if (res.ok) {
      showBanner('Program deleted.', 'green');
      await load();
    } else {
      showBanner('Delete failed.', 'red');
    }
  }

  // ── Copy WhatsApp join link ───────────────────────────────────
  function copyJoinLink(id: number, btn: HTMLButtonElement) {
    const url = `${window.location.origin}/join.php?id=${id}`;
    navigator.clipboard.writeText(url).then(() => {
      const orig = btn.innerHTML;
      btn.textContent = '✓ Copied!';
      btn.classList.add('text-green-700', 'border-green-300');
      setTimeout(() => { btn.innerHTML = orig; btn.classList.remove('text-green-700', 'border-green-300'); }, 2000);
    });
  }

  // ── Helpers ───────────────────────────────────────────────────
  function showBanner(msg: string, color: 'green' | 'red') {
    bannerEl.className = `rounded-lg px-4 py-3 text-sm text-center font-semibold mb-4
      ${color === 'green' ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-700'}`;
    bannerEl.textContent = msg;
    bannerEl.classList.remove('hidden');
    setTimeout(() => bannerEl.classList.add('hidden'), 4000);
  }

  function esc(s: string) {
    return String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  }

  // ── Wire ──────────────────────────────────────────────────────
  document.getElementById('prog-new-btn')!.addEventListener('click', openNew);
  document.getElementById('prog-panel-close')!.addEventListener('click', closePanel);
  document.getElementById('prog-form')!.addEventListener('submit', e => e.preventDefault());
  backdrop.addEventListener('click', closePanel);
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closePanel(); });

  load();
</script>
