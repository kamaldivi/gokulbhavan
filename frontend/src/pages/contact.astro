---
/**
 * Contact page — gokulbhavan.org/contact
 * Two tabs: Our Saṅgas (location cards) | Ask Guruji (question form + public Q&A)
 */
import Base from "@layouts/Base.astro";
import PageHero from "@components/PageHero.astro";

const recaptchaSiteKey = (import.meta as any).env?.VITE_RECAPTCHA_SITE_KEY ?? '';
---

<Base title="Contact" activePath="/contact"
     description="Find your local Gokul Bhavan saṅga or submit a question to Guruji.">

  <PageHero
    title="Contact Us"
    description="Find your local saṅga or reach us directly. We welcome all sincere seekers."
  />

  <!-- ── Tab bar ────────────────────────────────────────────────── -->
  <div class="border-b border-brand-tan bg-white sticky top-[var(--header-h,0px)] z-10">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 flex gap-1">
      <button data-tab="sangas"
              class="tab-btn px-5 py-3 text-sm font-semibold border-b-2 transition-colors
                     border-brand-navy text-brand-navy"
              aria-selected="true">
        Our Saṅgas
      </button>
      <button data-tab="ask-guruji"
              class="tab-btn px-5 py-3 text-sm font-semibold border-b-2 transition-colors
                     border-transparent text-brand-slate hover:text-brand-navy"
              aria-selected="false">
        Ask Guruji
      </button>
    </div>
  </div>

  <!-- ── Tab: Our Saṅgas ───────────────────────────────────────── -->
  <div id="tab-sangas" class="tab-panel">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 py-10 space-y-10">

      <section>
        <h2 class="font-display font-bold text-xl text-brand-navy mb-1">Our Locations</h2>
        <div class="w-10 h-0.5 bg-brand-lotus mb-6"></div>

        <!-- Loading skeleton -->
        <div id="loc-loading" class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          {Array.from({length: 4}).map(() => (
            <div class="h-48 rounded-2xl bg-brand-tan/30 animate-pulse"></div>
          ))}
        </div>

        <!-- Cards filled by JS -->
        <div id="loc-grid" class="hidden grid grid-cols-1 sm:grid-cols-2 gap-5"></div>
      </section>

    </div>
  </div>

  <!-- ── Tab: Ask Guruji ───────────────────────────────────────── -->
  <div id="tab-ask-guruji" class="tab-panel hidden">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 py-10">

      <!-- Guruji photo + intro -->
      <div class="flex flex-col items-center text-center mb-8">
        <img src="/assets/guruji.png" alt="Guruji"
             class="w-24 h-24 rounded-full object-cover object-top border-4 border-brand-tan shadow-md mb-4" />
        <h2 class="font-display font-bold text-2xl text-brand-navy mb-2">Ask Guruji</h2>
        <p class="text-sm text-brand-slate leading-relaxed max-w-md">
          Submit questions related to sādhana, previous Harikathā, scripture, or devotional practice.
          <strong class="text-brand-navy">Please submit sincere and relevant questions only.</strong>
        </p>
      </div>

      <!-- Form card -->
      <div class="bg-white border border-brand-tan rounded-2xl shadow-sm overflow-hidden">

        <!-- Honeypot -->
        <div class="absolute -left-[9999px] opacity-0 pointer-events-none" aria-hidden="true">
          <input type="text" id="ag-honeypot" name="website" autocomplete="off" tabindex="-1" />
        </div>

        <!-- ── Form body ── -->
        <div id="ag-form-section" class="px-6 py-7 space-y-6">

          <!-- Step 1: Email lookup -->
          <div id="ag-step-lookup">
            <p class="text-[11px] font-bold uppercase tracking-widest text-brand-slate/50 mb-3">
              Step 1 — Verify your registration
            </p>
            <label for="ag-email"
                   class="block text-xs font-semibold uppercase tracking-wider text-brand-slate mb-1.5">
              Registered Email Address <span class="text-brand-lotus">*</span>
            </label>
            <input type="email" id="ag-email" autocomplete="email"
                   placeholder="e.g. priya@example.com"
                   class="w-full px-3.5 py-2.5 text-sm text-brand-navy bg-brand-parchment border border-brand-tan
                          rounded-lg outline-none focus:border-brand-slate focus:ring-2 focus:ring-brand-slate/15
                          transition" />
            <button id="ag-btn-find" type="button"
                    class="mt-3 w-full py-2.5 bg-brand-slate hover:bg-brand-navy text-white text-sm font-bold
                           rounded-lg transition disabled:opacity-40 disabled:cursor-not-allowed">
              Find My Profile
            </button>
            <!-- Not found -->
            <div id="ag-not-found"
                 class="hidden mt-3 flex items-start gap-3 bg-brand-parchment border border-brand-tan
                        rounded-xl px-4 py-3">
              <p class="text-sm text-brand-slate leading-relaxed flex-1">
                No registered profile found for that email. Please register as a saṅga member first.
              </p>
              <a href="/register"
                 class="shrink-0 bg-brand-gold hover:bg-yellow-600 text-brand-navy text-xs font-bold
                        uppercase tracking-wide px-4 py-2 rounded-full transition whitespace-nowrap">
                Register
              </a>
            </div>
          </div>

          <!-- Step 2: Question -->
          <div id="ag-step-question" class="hidden space-y-4">
            <!-- Profile chip -->
            <div id="ag-profile-chip"
                 class="flex items-center justify-between gap-3 bg-emerald-50 border border-emerald-200
                        rounded-xl px-4 py-3">
              <div>
                <p id="ag-chip-name" class="text-sm font-bold text-emerald-800"></p>
                <p id="ag-chip-loc"  class="text-xs text-emerald-700 mt-0.5"></p>
              </div>
              <button id="ag-btn-change" type="button"
                      class="text-xs font-semibold text-emerald-700 hover:text-emerald-900 underline shrink-0">
                Change
              </button>
            </div>

            <div>
              <p class="text-[11px] font-bold uppercase tracking-widest text-brand-slate/50 mb-3">
                Step 2 — Your Question
              </p>
              <label for="ag-question"
                     class="block text-xs font-semibold uppercase tracking-wider text-brand-slate mb-1.5">
                Question <span class="text-brand-lotus">*</span>
              </label>
              <textarea id="ag-question" maxlength="3000" rows="5"
                        placeholder="Guruji, I have been wondering about…"
                        class="w-full px-3.5 py-2.5 text-sm text-brand-navy bg-brand-parchment border border-brand-tan
                               rounded-lg outline-none focus:border-brand-slate focus:ring-2 focus:ring-brand-slate/15
                               transition resize-y"></textarea>
            </div>

            <div id="ag-form-error"
                 class="hidden text-sm text-red-700 bg-red-50 border border-red-200 rounded-lg px-4 py-3">
            </div>

            <button id="ag-btn-submit" type="button" disabled
                    class="w-full py-3 bg-brand-slate hover:bg-brand-navy text-white text-sm font-bold
                           rounded-lg transition disabled:opacity-40 disabled:cursor-not-allowed">
              Submit Question
            </button>
          </div>

        </div>

        <!-- Thank-you state -->
        <div id="ag-thank-you" class="hidden px-6 py-10 text-center">
          <div class="text-5xl mb-4">🙏</div>
          <h3 class="font-display font-bold text-xl text-brand-navy mb-2">Hare Kṛṣṇa!</h3>
          <p class="text-sm text-brand-slate leading-relaxed mb-5">
            Your question has been submitted to Guruji.
          </p>
          <button id="ag-btn-another" type="button"
                  class="text-sm font-semibold text-brand-lotus hover:underline">
            Submit another question
          </button>
        </div>

      </div>

      <!-- ── Public Q&A ── -->
      <div id="ag-qa-section" class="hidden mt-10">
        <h3 class="font-display font-bold text-xl text-brand-navy mb-1">Questions &amp; Answers</h3>
        <div class="w-10 h-0.5 bg-brand-lotus mb-6"></div>
        <div id="ag-qa-loading" class="text-sm text-brand-slate/50 text-center py-6">Loading…</div>
        <div id="ag-qa-list" class="space-y-4"></div>
      </div>

      <!-- reCAPTCHA key carrier (read by script) -->
      <span id="ag-recaptcha-key" data-key={recaptchaSiteKey} class="hidden"></span>

      <!-- reCAPTCHA notice -->
      <p class="mt-6 text-center text-[11px] text-brand-slate/40 leading-relaxed">
        This form is protected by reCAPTCHA —
        <a href="https://policies.google.com/privacy" target="_blank" rel="noopener"
           class="hover:text-brand-slate transition-colors underline">Privacy</a>
        &amp;
        <a href="https://policies.google.com/terms" target="_blank" rel="noopener"
           class="hover:text-brand-slate transition-colors underline">Terms</a> apply.
      </p>

    </div>
  </div>

</Base>

<script>
const SITE_KEY = (document.getElementById('ag-recaptcha-key') as HTMLElement)?.dataset.key ?? '';

// ── Load reCAPTCHA dynamically when Ask Guruji tab is opened ──
let recaptchaLoaded = false;
function ensureRecaptcha() {
  if (recaptchaLoaded || !SITE_KEY) return;
  recaptchaLoaded = true;
  const s = document.createElement('script');
  s.src = `https://www.google.com/recaptcha/api.js?render=${encodeURIComponent(SITE_KEY)}`;
  document.head.appendChild(s);
}

// ── Tab switching ─────────────────────────────────────────────
document.querySelectorAll('.tab-btn').forEach((btn) => {
  btn.addEventListener('click', () => {
    const target = (btn as HTMLElement).dataset.tab!;

    document.querySelectorAll('.tab-btn').forEach((b) => {
      const active = (b as HTMLElement).dataset.tab === target;
      b.classList.toggle('border-brand-navy', active);
      b.classList.toggle('text-brand-navy',   active);
      b.classList.toggle('border-transparent', !active);
      b.classList.toggle('text-brand-slate',   !active);
      b.setAttribute('aria-selected', String(active));
    });

    document.querySelectorAll('.tab-panel').forEach((panel) => {
      panel.classList.toggle('hidden', panel.id !== `tab-${target}`);
    });

    if (target === 'ask-guruji') {
      ensureRecaptcha();
      loadQA();
    }
  });
});

// ── Location cards ────────────────────────────────────────────
const apiBase   = import.meta.env.VITE_API_BASE_URL ?? '';
const loadingEl = document.getElementById('loc-loading')!;
const gridEl    = document.getElementById('loc-grid')!;

(async function loadLocations() {
  try {
    const res = await fetch(`${apiBase}/api/sanga.php`);
    if (!res.ok) throw new Error();
    const sangas = await res.json();
    loadingEl.classList.add('hidden');
    renderLocations(sangas);
  } catch {
    loadingEl.classList.add('hidden');
  }
})();

function renderLocations(sangas: any[]) {
  gridEl.innerHTML = '';
  sangas.forEach((s: any) => {
    const addrLines: string[] = [];
    if (s.address_line1) addrLines.push(s.address_line1);
    if (s.address_line2) addrLines.push(s.address_line2);
    const cityLine = [s.city, s.state, s.postal_code].filter(Boolean).join(', ');
    if (cityLine) addrLines.push(cityLine);
    if (s.country) addrLines.push(s.country);

    const allContacts: string[] = [];
    if (s.contact_person) allContacts.push(s.contact_person);
    if (s.contacts_list)
      s.contacts_list.split('\n').map((c: string) => c.trim()).filter(Boolean)
        .forEach((c: string) => { if (!allContacts.includes(c)) allContacts.push(c); });

    const times = s.service_times
      ? s.service_times.split('\n').map((t: string) => t.trim()).filter(Boolean)
      : [];

    const card = document.createElement('div');
    card.className = 'bg-white rounded-2xl border border-brand-tan shadow-sm overflow-hidden flex flex-col';
    card.innerHTML = `
      <div class="bg-brand-parchment border-b border-brand-tan px-5 py-4 flex items-center gap-3">
        ${s.flag ? `<span class="text-xl leading-none">${esc(s.flag)}</span>` : ''}
        <div>
          <p class="font-display font-bold text-brand-navy text-sm leading-tight">${esc(s.sanga_name)}</p>
          ${s.region ? `<p class="text-[11px] text-brand-slate mt-0.5">${esc(s.region)}</p>` : ''}
        </div>
      </div>
      <div class="px-5 py-5 flex-1 space-y-3">
        ${s.description ? `<p class="text-xs text-brand-slate/70 italic leading-relaxed">${esc(s.description)}</p>` : ''}
        ${addrLines.length ? `
        <div class="flex items-start gap-3">
          <svg class="w-4 h-4 mt-0.5 shrink-0 fill-brand-slate/60" viewBox="0 0 24 24">
            <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5S10.62 6.5 12 6.5s2.5 1.12 2.5 2.5S13.38 11.5 12 11.5z"/>
          </svg>
          <div class="text-sm text-brand-slate leading-relaxed">
            ${addrLines.map(l => `<span class="block">${esc(l)}</span>`).join('')}
            ${s.map_url ? `<a href="${esc(s.map_url)}" target="_blank" rel="noopener noreferrer"
                             class="inline-block mt-1 text-xs text-brand-lotus hover:underline font-medium">
                             View on map →</a>` : ''}
          </div>
        </div>` : ''}
        ${allContacts.length ? `
        <div class="flex items-start gap-3">
          <svg class="w-4 h-4 mt-0.5 shrink-0 fill-brand-slate/60" viewBox="0 0 24 24">
            <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
          </svg>
          <div class="text-sm text-brand-slate leading-relaxed">
            ${allContacts.map(c => `<span class="block">${esc(c)}</span>`).join('')}
          </div>
        </div>` : ''}
        ${s.phone ? `
        <div class="flex items-center gap-3">
          <svg class="w-4 h-4 shrink-0 fill-brand-slate/60" viewBox="0 0 24 24">
            <path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>
          </svg>
          <a href="tel:${esc(s.phone.replace(/[\s()\-]/g,''))}"
             class="text-sm font-semibold text-brand-navy hover:text-brand-lotus transition-colors">
            ${esc(s.phone)}
          </a>
        </div>` : ''}
        ${s.email ? `
        <div class="flex items-center gap-3">
          <svg class="w-4 h-4 shrink-0 fill-brand-slate/60" viewBox="0 0 24 24">
            <path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4-8 5-8-5V6l8 5 8-5v2z"/>
          </svg>
          <a href="mailto:${esc(s.email)}"
             class="text-sm font-semibold text-brand-navy hover:text-brand-lotus transition-colors">
            ${esc(s.email)}
          </a>
        </div>` : ''}
        ${times.length ? `
        <div class="flex items-start gap-3">
          <svg class="w-4 h-4 mt-0.5 shrink-0 fill-brand-slate/60" viewBox="0 0 24 24">
            <path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zm.01 18c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67V7z"/>
          </svg>
          <div class="text-sm text-brand-slate leading-relaxed">
            ${times.map((t: string) => `<span class="block">${esc(t)}</span>`).join('')}
          </div>
        </div>` : ''}
      </div>`;
    gridEl.appendChild(card);
  });
  gridEl.classList.remove('hidden');
}

// ── Ask Guruji form ───────────────────────────────────────────
let selectedMember: any = null;

const agEmail      = document.getElementById('ag-email') as HTMLInputElement;
const agBtnFind    = document.getElementById('ag-btn-find') as HTMLButtonElement;
const agNotFound   = document.getElementById('ag-not-found')!;
const agStepLookup = document.getElementById('ag-step-lookup')!;
const agStepQ      = document.getElementById('ag-step-question')!;
const agChipName   = document.getElementById('ag-chip-name')!;
const agChipLoc    = document.getElementById('ag-chip-loc')!;
const agBtnChange  = document.getElementById('ag-btn-change')!;
const agQuestion   = document.getElementById('ag-question') as HTMLTextAreaElement;
const agBtnSubmit  = document.getElementById('ag-btn-submit') as HTMLButtonElement;
const agFormError  = document.getElementById('ag-form-error')!;
const agFormSec    = document.getElementById('ag-form-section')!;
const agThankYou   = document.getElementById('ag-thank-you')!;
const agBtnAnother = document.getElementById('ag-btn-another')!;

agBtnFind.addEventListener('click', doLookup);
agEmail.addEventListener('keydown', (e) => { if (e.key === 'Enter') doLookup(); });

function doLookup() {
  const email = agEmail.value.trim();
  agNotFound.classList.add('hidden');
  if (!email) { agEmail.focus(); return; }

  agBtnFind.disabled = true;
  agBtnFind.textContent = 'Searching…';

  fetch(`${apiBase}/api/lookup-member.php?email=${encodeURIComponent(email)}`)
    .then(r => r.json())
    .then(rows => {
      agBtnFind.disabled = false;
      agBtnFind.textContent = 'Find My Profile';
      if (!Array.isArray(rows) || rows.length === 0) {
        agNotFound.classList.remove('hidden');
        return;
      }
      selectMember(rows[0]);
    })
    .catch(() => {
      agBtnFind.disabled = false;
      agBtnFind.textContent = 'Find My Profile';
      agNotFound.classList.remove('hidden');
    });
}

function selectMember(m: any) {
  selectedMember = m;
  const loc = [m.city, m.country].filter(Boolean).join(', ');
  agChipName.textContent = m.spiritual_name || m.display_name;
  agChipLoc.textContent  = (m.spiritual_name ? m.display_name + (loc ? ' · ' + loc : '') : loc) || '';
  agStepLookup.classList.add('hidden');
  agStepQ.classList.remove('hidden');
  agBtnSubmit.disabled = agQuestion.value.trim().length < 10;
  agQuestion.focus();
}

agBtnChange.addEventListener('click', () => {
  selectedMember = null;
  agStepQ.classList.add('hidden');
  agStepLookup.classList.remove('hidden');
  agBtnSubmit.disabled = true;
  agQuestion.value = '';
  agEmail.value = '';
  agNotFound.classList.add('hidden');
  clearError();
  agEmail.focus();
});

agQuestion.addEventListener('input', () => {
  agBtnSubmit.disabled = agQuestion.value.trim().length < 10 || !selectedMember;
});

agBtnSubmit.addEventListener('click', () => {
  clearError();
  const question = agQuestion.value.trim();
  const honeypot = (document.getElementById('ag-honeypot') as HTMLInputElement).value;

  if (!selectedMember) { showError('Please find your profile first.'); return; }
  if (question.length < 10) { showError('Please write your question (at least 10 characters).'); return; }

  agBtnSubmit.disabled = true;
  agBtnSubmit.textContent = 'Submitting…';

  function doSubmit(token: string) {
    fetch(`${apiBase}/api/ask-guruji.php`, {
      method:  'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        registration_id: selectedMember.id,
        question, recaptcha: token, website: honeypot
      })
    })
    .then(res => res.json().then(d => ({ ok: res.ok, data: d })))
    .then(r => {
      if (r.ok) {
        agFormSec.classList.add('hidden');
        agThankYou.classList.remove('hidden');
      } else {
        showError(r.data.message || 'Something went wrong. Please try again.');
        agBtnSubmit.disabled = false;
        agBtnSubmit.textContent = 'Submit Question';
      }
    })
    .catch(() => {
      showError('Network error. Please check your connection and try again.');
      agBtnSubmit.disabled = false;
      agBtnSubmit.textContent = 'Submit Question';
    });
  }

  if (SITE_KEY && (window as any).grecaptcha) {
    (window as any).grecaptcha.ready(() => {
      (window as any).grecaptcha.execute(SITE_KEY, { action: 'ask_guruji' }).then(doSubmit);
    });
  } else {
    doSubmit('');
  }
});

agBtnAnother.addEventListener('click', () => {
  selectedMember = null;
  agQuestion.value = '';
  agEmail.value = '';
  agStepQ.classList.add('hidden');
  agStepLookup.classList.remove('hidden');
  agThankYou.classList.add('hidden');
  agFormSec.classList.remove('hidden');
  agBtnSubmit.disabled = true;
  agBtnSubmit.textContent = 'Submit Question';
  clearError();
});

function showError(msg: string) {
  agFormError.textContent = msg;
  agFormError.classList.remove('hidden');
  agFormError.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
}
function clearError() {
  agFormError.textContent = '';
  agFormError.classList.add('hidden');
}

// ── Public Q&A — loaded once when Ask Guruji tab first opens ─
let qaLoaded = false;
function loadQA() {
  if (qaLoaded) return;
  qaLoaded = true;

  fetch(`${apiBase}/api/questions-public.php`)
    .then(r => r.json())
    .then(rows => {
      const section  = document.getElementById('ag-qa-section')!;
      const loading  = document.getElementById('ag-qa-loading')!;
      const list     = document.getElementById('ag-qa-list')!;

      if (!Array.isArray(rows) || rows.length === 0) {
        loading.classList.add('hidden');
        return;
      }

      loading.classList.add('hidden');
      section.classList.remove('hidden');

      rows.forEach((item: any) => {
        const el = document.createElement('div');
        el.className = 'bg-white border border-brand-tan rounded-2xl overflow-hidden shadow-sm';
        el.innerHTML = `
          <div class="bg-brand-parchment border-b border-brand-tan px-5 py-4 text-sm font-semibold text-brand-navy leading-relaxed">
            ${esc(item.question)}
          </div>
          <div class="px-5 py-4">
            <p class="text-[10px] font-bold uppercase tracking-widest text-brand-slate/40 mb-2">Guruji's Response</p>
            <p class="text-sm text-brand-slate leading-relaxed whitespace-pre-wrap">${esc(item.response)}</p>
          </div>`;
        list.appendChild(el);
      });
    })
    .catch(() => { /* silently fail */ });
}

// ── Shared escape helper ──────────────────────────────────────
function esc(s: string) {
  return String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}
</script>

<style>
  .grecaptcha-badge { visibility: hidden; }
</style>
