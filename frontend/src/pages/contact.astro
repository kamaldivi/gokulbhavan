---
/**
 * Contact page — gokulbhavan.com/contact
 * Four sanga location cards + general enquiry form.
 */
import Base from "@layouts/Base.astro";
import PageHero from "@components/PageHero.astro";

const LOCATIONS = [
  {
    region: "Virginia, USA",
    flag: "🇺🇸",
    name: "Gokul Bhavan — Aldie",
    address: ["41901 White Mountain Ct", "Aldie, VA 20105", "USA"],
    contacts: ["Dr. Bhagavati Kanti Dasa"],
    phone: "+1 919-491-9536",
    email: "bkdasa@gmail.com",
  },
  {
    region: "North Carolina, USA",
    flag: "🇺🇸",
    name: "Cary Saṅga",
    address: ["712 Manassas Gap Pl", "Cary, NC 27519", "USA"],
    contacts: [
      "Dr. Nava Kishori Devi Dasi",
      "Dr. Prema Devi Dasi",
      "Sushant Krishna Dasa",
      "Dr. Bhagavati Kanti Dasa",
    ],
    phone: "+1 (732) 604-4465",
    email: "bkdasa@gmail.com",
  },
  {
    region: "Kanyakumari, India",
    flag: "🇮🇳",
    name: "Kanyakumari Saṅga",
    address: ["2/5 Mission Compound", "Kottaram, PIN 629703", "India"],
    contacts: ["Radhika Devi Dasi", "Dr. Bhagavati Kanti Dasa"],
    phone: "+91 750 222 2794",
    email: "bkdasa@gmail.com",
  },
  {
    region: "Lagos, Nigeria",
    flag: "🇳🇬",
    name: "Gokul Bhavan Badagry",
    address: ["54 Egan Oduremi", "Peace Avenue, Okoafo", "Badagry, Nigeria"],
    contacts: [],
    phone: "+234 803 983 5346",
    email: null,
  },
];
---

<Base title="Contact" activePath="/contact"
     description="Find your local Gokul Bhavan saṅga — locations in Virginia, North Carolina, India, and Nigeria.">

  <PageHero
    title="Contact Us"
    description="Find your local saṅga or reach us directly. We welcome all sincere seekers."
  />

  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-12 space-y-12">

    <!-- ── Location cards ──────────────────────────────────────── -->
    <section>
      <h2 class="font-display font-bold text-xl text-brand-navy mb-1">Our Locations</h2>
      <div class="w-10 h-0.5 bg-brand-lotus mb-6"></div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        {LOCATIONS.map((loc) => (
          <div class="bg-white rounded-2xl border border-brand-tan shadow-sm overflow-hidden flex flex-col">

            <!-- Header -->
            <div class="bg-brand-parchment border-b border-brand-tan px-5 py-4 flex items-center gap-3">
              <span class="text-xl leading-none">{loc.flag}</span>
              <div>
                <p class="font-display font-bold text-brand-navy text-sm leading-tight">{loc.name}</p>
                <p class="text-[11px] text-brand-slate mt-0.5">{loc.region}</p>
              </div>
            </div>

            <!-- Body -->
            <div class="px-5 py-5 flex-1 space-y-3">

              <!-- Address -->
              <div class="flex items-start gap-3">
                <svg class="w-4 h-4 mt-0.5 shrink-0 text-brand-slate fill-current" viewBox="0 0 24 24">
                  <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5S10.62 6.5 12 6.5s2.5 1.12 2.5 2.5S13.38 11.5 12 11.5z"/>
                </svg>
                <div class="text-sm text-brand-slate leading-relaxed">
                  {loc.address.map((line) => <span class="block">{line}</span>)}
                </div>
              </div>

              <!-- Contacts -->
              {loc.contacts.length > 0 && (
                <div class="flex items-start gap-3">
                  <svg class="w-4 h-4 mt-0.5 shrink-0 text-brand-slate fill-current" viewBox="0 0 24 24">
                    <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                  </svg>
                  <div class="text-sm text-brand-slate leading-relaxed">
                    {loc.contacts.map((c) => <span class="block">{c}</span>)}
                  </div>
                </div>
              )}

              <!-- Phone -->
              <div class="flex items-center gap-3">
                <svg class="w-4 h-4 shrink-0 text-brand-slate fill-current" viewBox="0 0 24 24">
                  <path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>
                </svg>
                <a href={`tel:${loc.phone.replace(/[\s()-]/g, "")}`}
                   class="text-sm font-semibold text-brand-navy hover:text-brand-lotus transition-colors">
                  {loc.phone}
                </a>
              </div>

              <!-- Email -->
              {loc.email && (
                <div class="flex items-center gap-3">
                  <svg class="w-4 h-4 shrink-0 text-brand-slate fill-current" viewBox="0 0 24 24">
                    <path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4-8 5-8-5V6l8 5 8-5v2z"/>
                  </svg>
                  <a href={`mailto:${loc.email}`}
                     class="text-sm font-semibold text-brand-navy hover:text-brand-lotus transition-colors">
                    {loc.email}
                  </a>
                </div>
              )}

            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ── General Enquiry form ─────────────────────────────────── -->
    <section>
      <h2 class="font-display font-bold text-xl text-brand-navy mb-1">General Enquiries</h2>
      <div class="w-10 h-0.5 bg-brand-lotus mb-6"></div>

      <div class="bg-brand-navy rounded-2xl overflow-hidden">
        <div class="px-6 sm:px-10 py-10">
          <p class="text-white/70 text-sm mb-7 leading-relaxed max-w-lg">
            Have a question about our programs, registrations, or spiritual guidance?
            Write to us — we are happy to help.
          </p>

          <form id="contact-form" class="space-y-5" novalidate>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div class="flex flex-col gap-1.5">
                <label for="c_name" class="text-xs font-semibold uppercase tracking-wide text-white/60">
                  Your Name <span class="text-brand-lotus">*</span>
                </label>
                <input type="text" id="c_name" name="name" required placeholder="Jane Smith"
                       class="rounded-lg border border-white/20 bg-white/10 px-3 py-2.5 text-sm text-white placeholder-white/30 focus:outline-none focus:border-brand-gold/60 focus:ring-2 focus:ring-brand-gold/20 transition" />
              </div>
              <div class="flex flex-col gap-1.5">
                <label for="c_email" class="text-xs font-semibold uppercase tracking-wide text-white/60">
                  Email <span class="text-brand-lotus">*</span>
                </label>
                <input type="email" id="c_email" name="email" required placeholder="jane@example.com"
                       class="rounded-lg border border-white/20 bg-white/10 px-3 py-2.5 text-sm text-white placeholder-white/30 focus:outline-none focus:border-brand-gold/60 focus:ring-2 focus:ring-brand-gold/20 transition" />
              </div>
            </div>

            <div class="flex flex-col gap-1.5">
              <label for="c_subject" class="text-xs font-semibold uppercase tracking-wide text-white/60">
                Subject <span class="text-brand-lotus">*</span>
              </label>
              <input type="text" id="c_subject" name="subject" required
                     placeholder="Programs, Registration, General Question…"
                     class="rounded-lg border border-white/20 bg-white/10 px-3 py-2.5 text-sm text-white placeholder-white/30 focus:outline-none focus:border-brand-gold/60 focus:ring-2 focus:ring-brand-gold/20 transition" />
            </div>

            <div class="flex flex-col gap-1.5">
              <label for="c_message" class="text-xs font-semibold uppercase tracking-wide text-white/60">
                Message <span class="text-brand-lotus">*</span>
              </label>
              <textarea id="c_message" name="message" rows="4" required
                        placeholder="How can we help you?"
                        class="rounded-lg border border-white/20 bg-white/10 px-3 py-2.5 text-sm text-white placeholder-white/30 focus:outline-none focus:border-brand-gold/60 focus:ring-2 focus:ring-brand-gold/20 transition resize-none"></textarea>
            </div>

            <div id="c-error"   class="hidden rounded-lg bg-red-900/50 border border-red-400/30 px-4 py-3 text-sm text-red-200"></div>
            <div id="c-success" class="hidden rounded-lg bg-emerald-900/50 border border-emerald-400/30 px-4 py-3 text-sm text-emerald-200">
              Thank you! Your message has been sent. We will get back to you shortly.
            </div>

            <button type="submit" id="c-submit"
                    class="w-full bg-brand-lotus hover:bg-pink-700 text-white font-display font-bold text-sm uppercase tracking-widest py-3.5 rounded-xl transition-colors shadow-sm">
              Send Message →
            </button>

          </form>
        </div>
      </div>
    </section>

  </div>

</Base>

<script>
  const form       = document.getElementById("contact-form") as HTMLFormElement;
  const errorBox   = document.getElementById("c-error")!;
  const successBox = document.getElementById("c-success")!;
  const submitBtn  = document.getElementById("c-submit") as HTMLButtonElement;

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    errorBox.classList.add("hidden");
    successBox.classList.add("hidden");

    const required = form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>("[required]");
    let firstInvalid: HTMLElement | null = null;
    required.forEach((el) => {
      if (!el.value.trim()) {
        el.classList.add("border-red-400/60");
        firstInvalid ??= el;
      } else {
        el.classList.remove("border-red-400/60");
      }
    });

    if (firstInvalid) {
      errorBox.textContent = "Please fill in all required fields.";
      errorBox.classList.remove("hidden");
      firstInvalid.scrollIntoView({ behavior: "smooth", block: "center" });
      return;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = "Sending…";

    try {
      const data = Object.fromEntries(new FormData(form));
      const apiBase = import.meta.env.VITE_API_BASE_URL ?? "http://localhost:5000";
      const res = await fetch(`${apiBase}/api/contact`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(data),
      });

      if (res.ok) {
        form.reset();
        successBox.classList.remove("hidden");
        successBox.scrollIntoView({ behavior: "smooth", block: "center" });
      } else {
        const body = await res.json().catch(() => ({}));
        errorBox.textContent = body.message ?? "Could not send your message. Please try again.";
        errorBox.classList.remove("hidden");
      }
    } catch {
      errorBox.textContent = "Could not connect. Please email bkdasa@gmail.com directly.";
      errorBox.classList.remove("hidden");
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = "Send Message →";
    }
  });

  form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>("input, textarea").forEach((el) => {
    el.addEventListener("input", () => el.classList.remove("border-red-400/60"));
  });
</script>
