# Copy this file to .env and fill in values before running npm run build.
# This file IS committed to git. .env is NOT (it's gitignored).

# Leave empty for production (API is on the same domain, so no prefix needed).
# Set to http://localhost:8000 or similar for local dev if running API separately.
VITE_API_BASE_URL=

# Google reCAPTCHA v3 — PUBLIC site key (safe to share, found in recaptcha admin console).
# Required for the Ask Guruji form in contact.astro.
# The SECRET key lives in api/config.php on the server (never put it here).
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_v3_site_key_here

# Global Zoom and YouTube Live URLs — keep in sync with ZOOM_URL / YOUTUBE_URL in api/config.php.
VITE_ZOOM_URL=https://zoom.us/j/2294369627?pwd=VHJPQ1dBTC9wVnV2dUd5UDVMYTJwQT09
VITE_YOUTUBE_URL=https://www.youtube.com/@bkdasa
